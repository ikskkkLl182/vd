local espT1, espT2 = 0, 0
connect(RunService.Heartbeat, function(dt)
    espT1 = espT1 + dt
    espT2 = espT2 + dt

    if espT1 >= 0.1 then
        espT1 = 0
        local cam = workspace.CurrentCamera
        if cam then
            local cp = cam.CFrame.Position
            for _, it in pairs(espItems) do
                local part = it.part
                if part and part.Parent then
                    if ESP.names then
                        it.lbl.Text = string.format("%s [%d]", it.extra and it.extra() or it.text, math.floor((cp - part.Position).Magnitude))
                    else
                        it.lbl.Text = ""
                    end
                end
            end
        end
    end

    if espT2 >= 0.5 then
        espT2 = 0
        if ESP.survivors or ESP.killer then espRefreshPlayers() end
    end
end)

