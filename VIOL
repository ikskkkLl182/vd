    corner(knob, 8)

    local click = new("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
    }, row)

    local state = default and true or false
    local obj = {}

    local function render()
        tween(track, {BackgroundColor3 = state and THEME.accent or THEME.off}, 0.2)
        tween(knob, {Position = state and UDim2.fromOffset(25, 3) or UDim2.fromOffset(3, 3)}, 0.2, Enum.EasingStyle.Back)
    end

    function obj.set(v)
        state = v and true or false
        render()
        pcall(callback, state)
    end

    function obj.get()
        return state
    end

    connect(click.Activated, function()
        obj.set(not state)
    end)

    if bindId then
        registerBind(bindId, defaultKey, function()
            obj.set(not state)
        end)
        makeBindButton(row, bindId, UDim2.new(1, -136, 0.5, -12))
    end

    render()
    return obj
end

