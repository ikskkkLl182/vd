-- keybinds (saved to file if the executor supports it)
---------------------------------------------------------------------
local SAVE_FILE = "vd_esp_binds_v2.json"
local savedBinds = {}

if readfile and isfile then
    pcall(function()
        if isfile(SAVE_FILE) then
            local decoded = HttpService:JSONDecode(readfile(SAVE_FILE))
            if type(decoded) == "table" then
                savedBinds = decoded
            end
        end
    end)
end

local binds = {}
local bindActions = {}
local bindRefresh = {}
local listeningId = nil

local function saveBinds()
    if not writefile then return end
    local data = {}
    for id, key in pairs(binds) do
        data[id] = key and key.Name or ""
    end
    pcall(function()
        writefile(SAVE_FILE, HttpService:JSONEncode(data))
    end)
end

local function keyText(key)
    if not key then return "None" end
    local n = key.Name
    n = string.gsub(n, "Control", "Ctrl")
    n = string.gsub(n, "^Left", "L")
    n = string.gsub(n, "^Right", "R")
    return n
end

local function registerBind(id, defaultKey, action)
    local resolved = defaultKey or false
    local saved = savedBinds[id]
    if type(saved) == "string" then
        if saved == "" then
            resolved = false
        else
            local ok, key = pcall(function() return Enum.KeyCode[saved] end)
            if ok and key then resolved = key end
        end
    end
    binds[id] = resolved
    bindActions[id] = action
end

local function makeBindButton(parent, id, position)
    local btn = new("TextButton", {
        Size = UDim2.fromOffset(72, 24),
        Position = position,
        BackgroundColor3 = THEME.bg,
        AutoButtonColor = false,
        Text = keyText(binds[id]),
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextColor3 = THEME.accent2,
    }, parent)
    corner(btn, 6)
    local st = new("UIStroke", {
        Thickness = 1,
        Color = THEME.off,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, btn)

    local function refresh()
        local listening = listeningId == id
        btn.Text = listening and "..." or keyText(binds[id])
        btn.TextColor3 = listening and THEME.text or (binds[id] and THEME.accent2 or THEME.dim)
        tween(st, {Color = listening and THEME.accent or THEME.off}, 0.15)
    end

    bindRefresh[id] = refresh

    connect(btn.Activated, function()
        local prev = listeningId
        if listeningId == id then
            listeningId = nil
        else
            listeningId = id
        end
        if prev and bindRefresh[prev] then bindRefresh[prev]() end
        refresh()
    end)

    refresh()
end

connect(UserInputService.InputBegan, function(input, processed)
    if listeningId then
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        local id = listeningId
        listeningId = nil
        if input.KeyCode == Enum.KeyCode.Escape then
        elseif input.KeyCode == Enum.KeyCode.Backspace then
            binds[id] = false
        else
            for otherId, key in pairs(binds) do
                if otherId ~= id and key == input.KeyCode then
                    binds[otherId] = false
                    if bindRefresh[otherId] then bindRefresh[otherId]() end
                end
            end
            binds[id] = input.KeyCode
        end
        if bindRefresh[id] then bindRefresh[id]() end
        saveBinds()
        return
    end

    if processed then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    for id, key in pairs(binds) do
        if key and key == input.KeyCode then
            local action = bindActions[id]
            if action then pcall(action) end
        end
    end
end)

