local function makeSlider(parent, y, labelText, onChange)
    new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(16, y),
        Size = UDim2.fromOffset(20, 20),
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextColor3 = THEME.dim,
        Text = labelText,
    }, parent)

    local track = new("Frame", {
        Position = UDim2.fromOffset(40, y + 4),
        Size = UDim2.new(1, -62, 0, 12),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        Active = true,
    }, parent)
    corner(track, 6)
    local grad = new("UIGradient", nil, track)

    local knob = new("Frame", {
        Size = UDim2.fromOffset(10, 20),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0, 0.5),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
    }, track)
    corner(knob, 4)
    new("UIStroke", {Thickness = 1.5, Color = Color3.new(0, 0, 0)}, knob)

    local s = {grad = grad}
    local dragging = false

    function s.set(v)
        knob.Position = UDim2.fromScale(math.clamp(v, 0, 1), 0.5)
    end

    local function fromInput(input)
        local w = track.AbsoluteSize.X
        if w <= 0 then return end
        local v = math.clamp((input.Position.X - track.AbsolutePosition.X) / w, 0, 1)
        s.set(v)
        onChange(v)
    end

    connect(track.InputBegan, function(input)
        if isPointer(input) then
            dragging = true
            fromInput(input)
        end
    end)
    connect(UserInputService.InputChanged, function(input)
        if dragging and isMove(input) then
            fromInput(input)
        end
    end)
    connect(UserInputService.InputEnded, function(input)
        if isPointer(input) then
            dragging = false
        end
    end)

    return s
end

