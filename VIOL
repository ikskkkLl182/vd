local VirtualInputManager = nil
pcall(function()
    VirtualInputManager = game:GetService("VirtualInputManager")
end)

local SC = {
    generator = false,
    heal = false,
    genPerfect = true,
    healPerfect = true,
}

local SC_CFG = {
    guiName = "SkillCheckPromptGui",
    guiWords = {"skillcheck", "skill", "check"},
    needleWords = {"line", "needle", "pointer", "hand", "arrow", "marker"},
    zoneWords = {"goal", "zone", "success", "target"},
    key = Enum.KeyCode.Space,
    perfectCenter = 111,
    perfectTol = 3.5,
    normalCenter = 127,
    normalTol = 3,
    lead = 0.012,
    ghExtra = 0,
    genRange = 12,
    playerRange = 12,
}

local function scMatch(name, words)
    name = string.lower(name)
    for _, w in ipairs(words) do
        if string.find(name, w, 1, true) then return true end
    end
    return false
end

local function scGuiVisible(obj)
    local p = obj
    while p do
        if p:IsA("GuiObject") and not p.Visible then return false end
        if p:IsA("ScreenGui") and not p.Enabled then return false end
        p = p.Parent
    end
    return true
end

local function scNorm(a)
    return a % 360
end

local function scDiff(a, b)
    return ((a - b + 180) % 360) - 180
end

local scN, scZ, scB = nil, nil, nil
local scLast, scPressed, scPressTime, scCtx, scSeenAt = nil, false, 0, nil, 0
local scT = 0
local scPressDir, scPressGoal = 1, nil
local scStill = 0

local function scReset()
    scN, scZ, scB = nil, nil, nil
    scLast, scPressed, scCtx, scStill = nil, false, nil, 0
    scT = 1
end

local function scFindAll()
    scN, scZ, scB = nil, nil, nil
    local pg = player:FindFirstChild("PlayerGui")
    if not pg then return end

    local function grab(g)
        local check = g:FindFirstChild("Check")
        local needle = check and check:FindFirstChild("Line")
        local zone = check and check:FindFirstChild("Goal")
        if not (needle and zone) then
            needle, zone = nil, nil
            for _, d in ipairs(g:GetDescendants()) do
                if d:IsA("GuiObject") then
                    if not needle and scMatch(d.Name, SC_CFG.needleWords) then
                        needle = d
                    elseif not zone and scMatch(d.Name, SC_CFG.zoneWords) then
                        zone = d
                    end
                end
            end
        end
        if needle and zone then
            scN, scZ = needle, zone

            -- Приоритет 1: кнопка, внутри которой находится сам чек
            local target = nil
            local p = check or needle
            while p and p ~= g do
                if p:IsA("TextButton") or p:IsA("ImageButton") then
                    target = p
                    break
                end
                p = p.Parent
            end

            -- Приоритет 2: любая видимая кнопка в этом же GUI
            if not target then
                local bestScore = -1
                for _, d in ipairs(g:GetDescendants()) do
                    if (d:IsA("TextButton") or d:IsA("ImageButton")) and d.Visible then
                        local sz = d.AbsoluteSize
                        local score = sz.X * sz.Y
                        if score > bestScore then
                            target = d
                            bestScore = score
                        end
                    end
                end
            end
            scB = target
            return true
        end
        return false
    end

    local main = pg:FindFirstChild(SC_CFG.guiName)
    if main and grab(main) then return end
    for _, g in ipairs(pg:GetChildren()) do
        if g ~= gui and g ~= main and g:IsA("ScreenGui") and scMatch(g.Name, SC_CFG.guiWords) then
            if grab(g) then return end
        end
    end
end

local SC_IDS = {
    generator = {"gen"},
    heal = {"heal"},
    trap = {"trap"},
}
local SC_ORDER = {"generator", "heal", "trap"}

local function scCtxFromChar()
    local chr = player.Character
    if not chr then return nil end
    for _, c in ipairs(chr:GetChildren()) do
        local n = string.lower(c.Name)
        if string.find(n, "skillcheck", 1, true) then
            for _, kind in ipairs(SC_ORDER) do
                if scMatch(n, SC_IDS[kind]) then return kind, c.Name end
            end
            return nil, c.Name
        end
    end
    return nil
end

local function scCtxProximity()
    local chr = player.Character
    local root = chr and chr:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local pos = root.Position

    local bestKind, bestDist = nil, math.huge
    local function consider(kind, dist, range)
        if dist <= range and dist < bestDist then
            bestKind, bestDist = kind, dist
        end
    end

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and string.lower(obj.Name) == "generator" and not obj:FindFirstChildOfClass("Humanoid") then
            local ok, cf = pcall(function() return obj:GetPivot() end)
            if ok then consider("generator", (cf.Position - pos).Magnitude, SC_CFG.genRange) end
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and not espIsKiller(plr) then
            local r = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
            if r then consider("heal", (r.Position - pos).Magnitude, SC_CFG.playerRange) end
        end
    end

    return bestKind
end

-- МОБИЛЬНЫЙ ВВОД: правильная эмуляция Touch
local function scPressMobile()
    local pos = nil
    if scB then
        local ok, p = pcall(function()
            return scB.AbsolutePosition + scB.AbsoluteSize / 2
        end)
        if ok and p then pos = p end
    end
    if not pos and scZ then
        local ok, p = pcall(function()
            return scZ.AbsolutePosition + scZ.AbsoluteSize / 2
        end)
        if ok and p then pos = p end
    end
    if not pos then return end

    -- 1. Пытаемся отправить правильное событие Touch через VirtualInputManager
    if VirtualInputManager then
        pcall(function()
            -- SendTouchEvent(true, x, y, game)
            VirtualInputManager:SendTouchEvent(true, pos.X, pos.Y, game)
            task.wait(0.05)
            VirtualInputManager:SendTouchEvent(false, pos.X, pos.Y, game)
        end)
    end

    -- 2. Если есть firesignal, дублируем Touch-события на кнопку и в UserInputService
    if firesignal then
        local beginInput = {
            UserInputType = Enum.UserInputType.Touch,
            Position = Vector3.new(pos.X, pos.Y, 0),
            InputState = Enum.UserInputState.Begin,
        }
        local endInput = {
            UserInputType = Enum.UserInputType.Touch,
            Position = Vector3.new(pos.X, pos.Y, 0),
            InputState = Enum.UserInputState.End,
        }
        if scB then
            pcall(function() firesignal(scB.InputBegan, beginInput, false) end)
            pcall(function() firesignal(scB.InputEnded, endInput, false) end)
            pcall(function() firesignal(scB.MouseButton1Down) end)
            pcall(function() firesignal(scB.MouseButton1Up) end)
            pcall(function() firesignal(scB.MouseButton1Click) end)
            pcall(function() firesignal(scB.Activated) end)
        end
        pcall(function() firesignal(UserInputService.InputBegan, beginInput, false) end)
        pcall(function() firesignal(UserInputService.InputEnded, endInput, false) end)
        pcall(function() firesignal(UserInputService.TouchTap, pos, Enum.UserInputType.Touch) end)
    end

    -- 3. Фолбэк: клик мышью (на некоторых мобильных экзекьюторах работает)
    if VirtualInputManager then
        pcall(function()
            VirtualInputManager:SendMouseMoveEvent(pos.X, pos.Y, game)
            task.wait(0.01)
            VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 0)
            task.wait(0.02)
            VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 0)
        end)
    end
end

local function scPressKeyboard()
    local sent = false
    if VirtualInputManager then
        sent = pcall(function()
            VirtualInputManager:SendKeyEvent(true, SC_CFG.key, false, game)
            task.wait(0.03)
            VirtualInputManager:SendKeyEvent(false, SC_CFG.key, false, game)
        end)
    end
    if not sent and firesignal then
        pcall(function()
            firesignal(UserInputService.InputBegan, {
                KeyCode = SC_CFG.key,
                UserInputType = Enum.UserInputType.Keyboard,
            }, false)
        end)
        pcall(function()
            firesignal(UserInputService.InputEnded, {
                KeyCode = SC_CFG.key,
                UserInputType = Enum.UserInputType.Keyboard,
            }, false)
        end)
    end
end

local function scPress()
    task.spawn(function()
        if UserInputService.KeyboardEnabled then
            scPressKeyboard()
        end
        if UserInputService.TouchEnabled then
            scPressMobile()
        end
    end)
end

