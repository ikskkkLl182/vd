-- skill check GUI:
--   PlayerGui.SkillCheckPromptGui.Check.Line - needle
--   PlayerGui.SkillCheckPromptGui.Check.Goal - zone
--   perfect: Line.Rotation = Goal.Rotation + 104..114
--   normal : Line.Rotation = Goal.Rotation + 115 and beyond
-- trap checks: Goal.Rotation stays 0, the zone is a white mark on the ring (its position changes every check).
-- The mark comes in two looks: a small white square, or an outlined bar with a solid white end.
local SC_CFG = {
    guiName = "SkillCheckPromptGui",
    guiWords = {"skillcheck", "skill", "check"},
    needleWords = {"line", "needle", "pointer", "hand", "arrow", "marker"},
    zoneWords = {"goal", "zone", "success", "target"},
    key = Enum.KeyCode.Space,
    perfectCenter = 111,   -- press point inside the perfect zone (104..114); late -> +1..2, early -> -1..2
    perfectTol = 3.5,      -- tolerance for perfect hit
    normalCenter = 127,    -- press point for normal hit (further than the white zone)
    normalTol = 3,
    lead = 0.012,          -- lead time in seconds; late -> lower, early -> higher
    ghExtra = 0,           -- extra target shift (degrees). plus = press later
    trapOffset = 8,        -- trap: START value of the press point past the zone centre (it calibrates itself, see below)
    trapTol = 3.5,         -- trap: tolerance for the press
    trapZone = -75,        -- trap fallback (zone mark not found): fixed point, only right for the first check
    genRange = 12,
    playerRange = 12,
}

local function scMatch(name, words)
    name = string.lower(name)
    for _, w in ipairs(words) do
        if string.find(name, w, 1, true) then return true end
    end
    return false
end

local function scGuiVisible(obj)
    local p = obj
    while p do
        if p:IsA("GuiObject") and not p.Visible then return false end
        if p:IsA("ScreenGui") and not p.Enabled then return false end
        p = p.Parent
    end
    return true
end

local function scNorm(a)
    return a % 360
end

-- shortest angle difference a - b in [-180, 180)
local function scDiff(a, b)
    return ((a - b + 180) % 360) - 180
end

-- real position of a gui element on screen, with the rotation of all its parents applied
local function guiCenter(o)
    return o.AbsolutePosition + o.AbsoluteSize / 2
end

local function visCenter(o)
    local p = guiCenter(o)
    local a = o.Parent
    while a and a:IsA("GuiObject") do
        local c = guiCenter(a)
        local r = math.rad(a.Rotation)
        local v = p - c
        p = c + Vector2.new(v.X * math.cos(r) - v.Y * math.sin(r), v.X * math.sin(r) + v.Y * math.cos(r))
        a = a.Parent
    end
    return p
end

-- angle clockwise from "up", degrees (same convention as GuiObject.Rotation)
local function scAngle(p, c)
    return math.deg(math.atan2(p.X - c.X, -(p.Y - c.Y))) % 360
end

local function scBright(c)
    return c.R > 0.75 and c.G > 0.75 and c.B > 0.75
end

-- solid white element (filled frame or tinted image)
local function scIsWhite(o)
    if (o:IsA("ImageLabel") or o:IsA("ImageButton")) and o.ImageTransparency < 0.5 and scBright(o.ImageColor3) then
        return true
    end
    if o:IsA("GuiObject") and o.BackgroundTransparency < 0.5 and scBright(o.BackgroundColor3) then
        return true
    end
    return false
end

-- element drawn only as a white outline (UIStroke), like the long bar of the second zone look
local function scIsOutline(o)
    for _, ch in ipairs(o:GetChildren()) do
        if ch:IsA("UIStroke") and ch.Enabled and ch.Thickness > 0 and ch.Transparency < 0.5 and scBright(ch.Color) then
            return true
        end
    end
    return false
end

-- 3 = solid bright element, 2 = bright outline only, 1 = any other visible small element, 0 = invisible
local function scVisKind(o)
    if scIsWhite(o) then return 3 end
    if scIsOutline(o) then return 2 end
    if (o:IsA("ImageLabel") or o:IsA("ImageButton")) and o.ImageTransparency < 0.9 and o.Image ~= "" then return 1 end
    if o.BackgroundTransparency < 0.9 then return 1 end
    return 0
end

local scN, scZ, scB = nil, nil, nil
local scLast, scPressed, scPressTime, scCtx, scSeenAt = nil, false, 0, nil, 0
local scT = 0
local scPressDir, scPressGoal = 1, nil
local scAutoUntil = 0                 -- while our own press is in flight, learning ignores Space
local scLastG, scPrevLV = nil, nil    -- previous needle angle on screen / previous zone source value
local scPressSrcFn, scPressSrcV = nil, nil
local scStill, scReleasedAt = 0, 0
local scMoveStart, scWasMoving = 0, false
local scOutAlive = true
-- trap chain state
local scZoneObj, scZoneScanAt, scZoneKind = nil, 0, 0   -- cached zone mark
local scLastZone, scZoneSame = nil, 0    -- last zone angle / frames it stayed the same
local scPressZone = nil                  -- zone angle we pressed for (to see when the next check starts)
local scZoneEverFound = false
local scTrapWarned = false
local scNoZoneDumped = false             -- dumped the gui once for this check because no zone mark was found
local scTrapLatchUntil = 0               -- keeps "this is a trap check" for a few seconds between checks
-- press point past the zone centre; corrected after every press (see the Space listener below)
local scTrapOffset = env.__VDTrapOffset or SC_CFG.trapOffset
local scEvalPending = nil                -- {zone, dir, t} of the last trap press, waiting for its input event

local function scReset()
    scN, scZ, scB = nil, nil, nil
    scLast, scPressed, scCtx, scLastG, scPrevLV, scStill = nil, false, nil, nil, nil, 0
    scLastZone, scZoneSame, scPressZone, scZoneObj = nil, 0, nil, nil
    scNoZoneDumped = false
    scT = 1 -- search again right away
end

local function scFindAll()
    scN, scZ, scB = nil, nil, nil
    local pg = player:FindFirstChild("PlayerGui")
    if not pg then return end

    local function grab(g)
        local check = g:FindFirstChild("Check")
        local needle = check and check:FindFirstChild("Line")
        local zone = check and check:FindFirstChild("Goal")
        if not (needle and zone) then
            needle, zone = nil, nil
            for _, d in ipairs(g:GetDescendants()) do
                if d:IsA("GuiObject") then
                    if not needle and scMatch(d.Name, SC_CFG.needleWords) then
                        needle = d
                    elseif not zone and scMatch(d.Name, SC_CFG.zoneWords) then
                        zone = d
                    end
                end
            end
        end
        if needle and zone then
            scN, scZ = needle, zone
            for _, d in ipairs(g:GetDescendants()) do
                if d:IsA("TextButton") or d:IsA("ImageButton") then
                    scB = d
                    break
                end
            end
            return true
        end
        return false
    end

    local main = pg:FindFirstChild(SC_CFG.guiName)
    if main and grab(main) then return end
    for _, g in ipairs(pg:GetChildren()) do
        if g ~= gui and g ~= main and g:IsA("ScreenGui") and scMatch(g.Name, SC_CFG.guiWords) then
            if grab(g) then return end
        end
    end
end

-- the zone of a trap check = the white mark on the ring (solid square, or the solid end of a bar,
-- or - if nothing is solid - an outlined bar).
-- returns its angle on the ring (clockwise from up, same space as Line.Rotation), the element and its kind
-- (2 = solid, 1 = outline), or nil
local function scFindZoneAngle(force)
    local check = scN and scN.Parent
    if not (check and check:IsA("GuiObject")) then return nil end
    local size = math.min(check.AbsoluteSize.X, check.AbsoluteSize.Y)
    if size <= 0 then return nil end
    local c = visCenter(scN) -- the needle turns around its own centre
    local now = os.clock()

    -- cached element: still valid while it is on screen and still looks like the zone mark
    local obj = scZoneObj
    if not force and obj and now - scZoneScanAt < 0.4
        and obj.Parent and obj:IsDescendantOf(game) and scGuiVisible(obj)
        and scVisKind(obj) == scZoneKind then
        return scAngle(visCenter(obj), c), obj, scZoneKind
    end

    -- search the whole skill check gui (the second zone look may live outside "Check")
    local root = scN:FindFirstAncestorOfClass("ScreenGui") or check
    local best, bestScore, bestPt, bestKind = nil, -math.huge, nil, 0
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("GuiObject") and d ~= scN and not d:IsDescendantOf(scN) and scGuiVisible(d) then
            local kind = scVisKind(d)
            if kind > 0 then
                local sz = math.max(d.AbsoluteSize.X, d.AbsoluteSize.Y)
                if sz > 0 and sz <= size * 0.4 then
                    local pt = visCenter(d)
                    local dist = (pt - c).Magnitude
                    if dist > size * 0.25 and dist < size * 0.75 then
                        local area = d.AbsoluteSize.X * d.AbsoluteSize.Y
                        -- solid beats outline, then the smallest piece wins
                        local score = kind * 1e6 - area
                        if score > bestScore then
                            best, bestScore, bestPt, bestKind = d, score, pt, kind
                        end
                    end
                end
            end
        end
    end
    scZoneObj, scZoneScanAt, scZoneKind = best, now, bestKind
    if best then return scAngle(bestPt, c), best, bestKind end
    return nil
end

-- lists every element of the skill check gui (name / rotation / position / color); printed and copied to the
-- clipboard (if the executor has setclipboard) so it can be pasted into a chat
local function scDumpCheck(why)
    local check = scN and scN.Parent
    if not check then
        scLog("[SC] dump: no skill check on screen")
        return
    end
    local root = scN:FindFirstAncestorOfClass("ScreenGui") or check
    local out = {}
    table.insert(out, string.format("[SC] check dump (%s): needle rot=%.0f goal rot=%.0f", why, scN.Rotation, scZ and scZ.Rotation or 0))
    local n = 0
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("GuiObject") then
            n = n + 1
            if n > 90 then
                table.insert(out, "  ...")
                break
            end
            local img = d:IsA("ImageLabel") or d:IsA("ImageButton")
            local col = img and d.ImageColor3 or d.BackgroundColor3
            local tr = img and d.ImageTransparency or d.BackgroundTransparency
            local name = (string.gsub(d:GetFullName(), "^.*SkillCheckPromptGui%.", ""))
            table.insert(out, string.format("  %s [%s] vis=%s rot=%.0f pos=%.0f,%.0f size=%.0f,%.0f col=%d,%d,%d tr=%.2f outline=%s kind=%d",
                name, d.ClassName, tostring(scGuiVisible(d)), d.Rotation,
                d.AbsolutePosition.X, d.AbsolutePosition.Y, d.AbsoluteSize.X, d.AbsoluteSize.Y,
                math.floor(col.R * 255 + 0.5), math.floor(col.G * 255 + 0.5), math.floor(col.B * 255 + 0.5), tr,
                tostring(scIsOutline(d)), scVisKind(d)))
        end
    end
    for _, line in ipairs(out) do pcall(print, line) end
    local copied = false
    if setclipboard then
        copied = (pcall(setclipboard, table.concat(out, "\n")))
    end
    scLog("[SC] dump: " .. #out .. " lines" .. (copied and ", copied to clipboard - paste it into the chat" or " (see console)"))
end

-- skill check id in the character -> type. add a substring here if the game uses another id
-- (the real id is printed in F9 as "[SC] press ... id=")
local SC_IDS = {
    generator = {"gen"},
    heal = {"heal"},
    trap = {"trap"},
}
local SC_ORDER = {"generator", "heal", "trap"}

local function scCtxFromChar()
    local chr = player.Character
    if not chr then return nil end
    for _, c in ipairs(chr:GetChildren()) do
        local n = string.lower(c.Name)
        if string.find(n, "skillcheck", 1, true) then
            for _, kind in ipairs(SC_ORDER) do
                if scMatch(n, SC_IDS[kind]) then return kind, c.Name end
            end
            return nil, c.Name
        end
    end
    return nil
end

