local function pickerRender()
    local h, s, v = hsv[1], hsv[2], hsv[3]
    local c = Color3.fromHSV(h, s, v)
    preview.BackgroundColor3 = c
    satS.grad.Color = ColorSequence.new(Color3.fromHSV(h, 0, v), Color3.fromHSV(h, 1, v))
    valS.grad.Color = ColorSequence.new(Color3.new(0, 0, 0), Color3.fromHSV(h, s, 1))
    rgbLabel.Text = string.format(
        "RGB: %d, %d, %d",
        math.floor(c.R * 255 + 0.5),
        math.floor(c.G * 255 + 0.5),
        math.floor(c.B * 255 + 0.5)
    )
end

local function pickerApply()
    if not pickKey then return end
    local c = Color3.fromHSV(hsv[1], hsv[2], hsv[3])
    ESPColors[pickKey] = c
    if colorSwatches[pickKey] then
        colorSwatches[pickKey].BackgroundColor3 = c
    end
    espApplyColors()
    pickerRender()
end

