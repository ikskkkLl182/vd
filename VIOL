-- геометрия: реальное положение элемента на экране с учётом поворота всех родителей
local function guiCenter(o)
    return o.AbsolutePosition + o.AbsoluteSize / 2
end

local function visCenter(o)
    local p = guiCenter(o)
    local a = o.Parent
    while a and a:IsA("GuiObject") do
        local c = guiCenter(a)
        local r = math.rad(a.Rotation)
        local v = p - c
        p = c + Vector2.new(v.X * math.cos(r) - v.Y * math.sin(r), v.X * math.sin(r) + v.Y * math.cos(r))
        a = a.Parent
    end
    return p
end

-- угол по часовой от "вверх", градусы
local function scAngle(p, c)
    return math.deg(math.atan2(p.X - c.X, -(p.Y - c.Y))) % 360
end

local function scIsWhite(o)
    if o:IsA("ImageLabel") or o:IsA("ImageButton") then
        local c = o.ImageColor3
        return o.ImageTransparency < 0.5 and c.R > 0.85 and c.G > 0.85 and c.B > 0.85
    end
    if o:IsA("Frame") then
        local c = o.BackgroundColor3
        return o.BackgroundTransparency < 0.5 and c.R > 0.85 and c.G > 0.85 and c.B > 0.85
    end
    return false
end

-- check-фрейм, его центр на экране и размер
local function scBase()
    if not scN then return nil end
    local check = scN.Parent
    if not (check and check:IsA("GuiObject")) then return nil end
    local size = math.min(check.AbsoluteSize.X, check.AbsoluteSize.Y)
    if size <= 0 then return nil end
    return check, visCenter(check), size
end

-- конец стрелки на экране (точка) либо nil
local function scTip(c, size)
    local tip, tipDist = nil, size * 0.15
    local cands = scN:GetDescendants()
    table.insert(cands, scN)
    for _, d in ipairs(cands) do
        if d:IsA("GuiObject") and scGuiVisible(d) then
            local pt = visCenter(d)
            local dist = (pt - c).Magnitude
            if dist > tipDist then tip, tipDist = pt, dist end
        end
    end
    return tip
end

local function scTipAngle(c, size)
    local pt = scTip(c, size)
    return pt and scAngle(pt, c) or nil
end

-- белый квадрат зоны на экране (точка) либо nil
local function scZoneWhite(check, c, size)
    local zone, zoneArea = nil, math.huge
    for _, d in ipairs(check:GetDescendants()) do
        if d:IsA("GuiObject") and d ~= scN and not d:IsDescendantOf(scN)
            and scGuiVisible(d) and scIsWhite(d) then
            local sz = math.max(d.AbsoluteSize.X, d.AbsoluteSize.Y)
            if sz > 0 and sz <= size * 0.3 then
                local pt = visCenter(d)
                if (pt - c).Magnitude > size * 0.3 then
                    local area = d.AbsoluteSize.X * d.AbsoluteSize.Y
                    if area < zoneArea then zone, zoneArea = pt, area end
                end
            end
        end
    end
    return zone
end

-- возвращает: угол белого квадрата и угол конца стрелки (оба на экране), либо nil
local function scGeom()
    local check, c, size = scBase()
    if not check then return nil end
    local zone = scZoneWhite(check, c, size)
    if not zone then return nil end
    local tip = scTip(c, size)
    if not tip then return nil end
    return scAngle(zone, c), scAngle(tip, c)
end

---------------------------------------------------------------------
-- обучение капкана: ищем, какой элемент в Check несёт угол зоны
---------------------------------------------------------------------
local function scPathOf(d, root)
    local parts = {}
    local o = d
    while o and o ~= root do
        table.insert(parts, 1, o.Name)
        o = o.Parent
    end
    return table.concat(parts, "/")
end

local function scResolve(root, path)
    local o = root
    for name in string.gmatch(path, "[^/]+") do
        o = o and o:FindFirstChild(name)
    end
    return o
end

-- все числа-кандидаты в Check (без стрелки): Rotation, UIGradient.Rotation, угол на экране
local function scSnapshot(check, c, size)
    local vals = {}
    for _, d in ipairs(check:GetDescendants()) do
        if d ~= scN and not d:IsDescendantOf(scN) then
            if d:IsA("GuiObject") then
                local path = scPathOf(d, check)
                vals["R:" .. path] = scNorm(d.Rotation)
                if scGuiVisible(d) then
                    local pt = visCenter(d)
                    if (pt - c).Magnitude > size * 0.15 then
                        vals["G:" .. path] = scAngle(pt, c)
                    end
                end
            elseif d:IsA("UIGradient") then
                vals["U:" .. scPathOf(d, check)] = scNorm(d.Rotation)
            end
        end
    end
    vals["T:screen"] = 0
    return vals
end

local function scSrcValue(check, c, kind, path)
    if kind == "T" then return 0 end
    local o = scResolve(check, path)
    if not o then return nil end
    if kind == "R" then
        return o:IsA("GuiObject") and scNorm(o.Rotation) or nil
    elseif kind == "U" then
        return o:IsA("UIGradient") and scNorm(o.Rotation) or nil
    elseif kind == "G" then
        if not (o:IsA("GuiObject") and scGuiVisible(o)) then return nil end
        return scAngle(visCenter(o), c)
    end
    return nil
end

local function scLearnVal()
    local src = SC_LEARN.src
    if not src then return nil end
    local check, c = scBase()
    if not check then return nil end
    return scSrcValue(check, c, src.kind, src.path)
end

-- ищет источник, у которого (needle - sign*value) одинаков во всех попаданиях
local function scSolveWindow(list)
    local n = #list
    local best = nil
    for key in pairs(list[n].vals) do
        local kind, path = string.match(key, "^(%a):(.+)$")
        if kind then
            local useTip = (kind == "G" or kind == "T")
            local ok = true
            local vx, vy = 0, 0
            for _, r in ipairs(list) do
                local v = r.vals[key]
                if v == nil or (useTip and r.tip == nil) then
                    ok = false
                    break
                end
                vx = vx + math.cos(math.rad(v))
                vy = vy + math.sin(math.rad(v))
            end
            -- константный источник зону не отслеживает (кроме T: зона фиксирована на экране)
            if ok and (kind == "T" or math.sqrt(vx * vx + vy * vy) / n < 0.98) then
                for _, sign in ipairs(kind == "T" and {1} or {1, -1}) do
                    local sx, sy = 0, 0
                    for _, r in ipairs(list) do
                        local base = useTip and r.tip or r.rot
                        local o = math.rad(base - sign * r.vals[key])
                        sx = sx + math.cos(o)
                        sy = sy + math.sin(o)
                    end
                    local R = math.sqrt(sx * sx + sy * sy) / n
                    local score = R + ((kind == "R" or kind == "U") and 0.0005 or 0)
                    if R >= SC_CFG.learnR and (not best or score > best.score) then
                        best = {
                            kind = kind, path = path, sign = sign,
                            off = math.deg(math.atan2(sy, sx)) % 360,
                            score = score, R = R,
                        }
                    end
                end
            end
        end
    end
    return best
end

local function scLearnSolve()
    local recs = SC_LEARN.recs
    local n = #recs
    if n < SC_CFG.learnMin then
        print(string.format("[SC] learn %d/%d - жми Space в идеал", n, SC_CFG.learnMin))
        return
    end
    for k = n, SC_CFG.learnMin, -1 do
        local list = {}
        for i = n - k + 1, n do table.insert(list, recs[i]) end
        local best = scSolveWindow(list)
        if best then
            SC_LEARN.src = {kind = best.kind, path = best.path, sign = best.sign, off = best.off}
            scLearnSave(SC_LEARN.src)
            print(string.format("[SC] trap learned: %s:%s sign=%d off=%.1f R=%.4f n=%d",
                best.kind, best.path, best.sign, best.off, best.R, k))
            return
        end
    end
    print("[SC] learn: источник зоны не найден (n=" .. n .. "), жми ещё в идеал / кинь vd_rec.txt")
end

local function scLearnAdd(rot)
    local check, c, size = scBase()
    if not check then return end
    local rec = {
        rot = rot,
        tip = scTipAngle(c, size),
        vals = scSnapshot(check, c, size),
    }
    table.insert(SC_LEARN.recs, rec)
    if #SC_LEARN.recs > 8 then table.remove(SC_LEARN.recs, 1) end
    scLearnSolve()
end

local function scSnapString(vals)
    local keys = {}
    for k in pairs(vals) do table.insert(keys, k) end
    table.sort(keys)
    local out = {}
    for _, k in ipairs(keys) do
        table.insert(out, string.format("%s=%.1f", k, vals[k]))
    end
    return table.concat(out, " ")
end

local function scFindAll()
    scN, scZ, scB = nil, nil, nil
    local pg = player:FindFirstChild("PlayerGui")
    if not pg then return end

    local function grab(g)
        local check = g:FindFirstChild("Check")
        local needle = check and check:FindFirstChild("Line")
        local zone = check and check:FindFirstChild("Goal")
        if not (needle and zone) then
            needle, zone = nil, nil
            for _, d in ipairs(g:GetDescendants()) do
                if d:IsA("GuiObject") then
                    if not needle and scMatch(d.Name, SC_CFG.needleWords) then
                        needle = d
                    elseif not zone and scMatch(d.Name, SC_CFG.zoneWords) then
                        zone = d
                    end
                end
            end
        end
        if needle and zone then
            scN, scZ = needle, zone
            for _, d in ipairs(g:GetDescendants()) do
                if d:IsA("TextButton") or d:IsA("ImageButton") then
                    scB = d
                    break
                end
            end
            return true
        end
        return false
    end

    local main = pg:FindFirstChild(SC_CFG.guiName)
    if main and grab(main) then return end
    for _, g in ipairs(pg:GetChildren()) do
        if g ~= gui and g ~= main and g:IsA("ScreenGui") and scMatch(g.Name, SC_CFG.guiWords) then
            if grab(g) then return end
        end
    end
end

-- точный способ: при скилчеке в персонаже появляется объект "Skillcheck-..."
-- id скилчека в персонаже -> тип. гены/лечение/капкан идут через одну таблицу и один путь
-- (один gui, одни углы, один press); тип нужен только чтобы выбрать, какой тумблер его разрешает.
-- если в игре id другой — допиши подстроку сюда, реальное имя печатается в F9 как "[SC] press ... id=".
-- капкан приходит как "Skillcheck-player" -> по id не определяется, тип берётся по близости (капкан/атрибуты).
local SC_IDS = {
    generator = {"gen"},
    heal = {"heal"},
    trap = {"trap", "free", "escape", "bear"},
}
local SC_ORDER = {"generator", "heal", "trap"}

local function scCtxFromChar()
    local chr = player.Character
    if not chr then return nil end
    for _, c in ipairs(chr:GetChildren()) do
        local n = string.lower(c.Name)
        if string.find(n, "skillcheck", 1, true) then
            for _, kind in ipairs(SC_ORDER) do
                if scMatch(n, SC_IDS[kind]) then return kind, c.Name end
            end
            return nil, c.Name
        end
    end
    return nil
end

-- запасной способ: по ближайшему объекту
local function scCtxProximity()
    local chr = player.Character
    local root = chr and chr:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local pos = root.Position

    for _, n in ipairs({"Trapped", "InTrap", "Caught", "Stuck"}) do
        if chr:GetAttribute(n) == true or player:GetAttribute(n) == true then
            return "trap"
        end
    end

    local bestKind, bestDist = nil, math.huge
    local function consider(kind, dist, range)
        if dist <= range and dist < bestDist then
            bestKind, bestDist = kind, dist
        end
    end

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and not obj:FindFirstChildOfClass("Humanoid") then
            local n = string.lower(obj.Name)
            local kind, range
            if n == "generator" then
                kind, range = "generator", SC_CFG.genRange
            elseif string.find(n, "trap", 1, true) then
                kind, range = "trap", SC_CFG.trapRange
            end
            if kind then
                local ok, cf = pcall(function() return obj:GetPivot() end)
                if ok then consider(kind, (cf.Position - pos).Magnitude, range) end
            end
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and not espIsKiller(plr) then
            local r = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
            if r then consider("heal", (r.Position - pos).Magnitude, SC_CFG.playerRange) end
        end
    end

    return bestKind
end

-- VirtualInputManager первым (реальный ввод), firesignal только если VIM нет/упал:
-- firesignal на InputBegan не кидает ошибку даже когда игра фейковый InputObject игнорит
local function scPress()
    scAutoUntil = os.clock() + 0.2
    task.spawn(function()
        local sent = false
        if VirtualInputManager then
            sent = pcall(function()
                VirtualInputManager:SendKeyEvent(true, SC_CFG.key, false, game)
                task.wait(0.03)
                VirtualInputManager:SendKeyEvent(false, SC_CFG.key, false, game)
            end)
        end
        if not sent and firesignal then
            pcall(function()
                firesignal(UserInputService.InputBegan, {
                    KeyCode = SC_CFG.key,
                    UserInputType = Enum.UserInputType.Keyboard,
                }, false)
            end)
        end
        if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled and scB and firesignal then
            pcall(function() firesignal(scB.MouseButton1Down) end)
            pcall(function() firesignal(scB.MouseButton1Click) end)
            pcall(function() firesignal(scB.Activated) end)
        end
    end)
end

