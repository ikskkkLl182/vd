-- open / close menu
---------------------------------------------------------------------
local opened = true

-- Modal button frees the cursor (including first person)
local modalBtn = new("TextButton", {
    Size = UDim2.fromOffset(0, 0),
    BackgroundTransparency = 1,
    Text = "",
    Modal = true,
}, main)

-- remember mouse state at the first force and restore it on close,
-- otherwise the camera stays in Default and only rotates with RMB
local prevMouseIcon = UserInputService.MouseIconEnabled
local prevMouseBehavior = UserInputService.MouseBehavior
local mouseForced = false

local function mouseRelease()
    if not mouseForced then
        prevMouseIcon = UserInputService.MouseIconEnabled
        prevMouseBehavior = UserInputService.MouseBehavior
        mouseForced = true
    end
end

-- what the game tried to set while the menu was forcing the cursor (round start etc.)
-- our own forced values are Default / icon on, so anything else is the game's
local gameBehavior, gameIcon = nil, nil
connect(UserInputService:GetPropertyChangedSignal("MouseBehavior"), function()
    if opened and mouseForced then
        local v = UserInputService.MouseBehavior
        if v ~= Enum.MouseBehavior.Default then gameBehavior = v end
    end
end)
connect(UserInputService:GetPropertyChangedSignal("MouseIconEnabled"), function()
    if opened and mouseForced and UserInputService.MouseIconEnabled == false then
        gameIcon = false
    end
end)

local function mouseRestore()
    if not mouseForced then return end
    mouseForced = false
    local behavior = gameBehavior or prevMouseBehavior
    local iconOn = prevMouseIcon
    if gameIcon ~= nil then iconOn = gameIcon end
    gameBehavior, gameIcon = nil, nil
    -- first person lock: the game wants the cursor hidden and centered
    if player.CameraMode == Enum.CameraMode.LockFirstPerson then
        behavior = Enum.MouseBehavior.LockCenter
        iconOn = false
    end
    UserInputService.MouseIconEnabled = iconOn
    UserInputService.MouseBehavior = behavior
end

local function setOpen(v)
    opened = v
    if v then
        modalBtn.Modal = true
        main.Visible = true
        tween(scale, {Scale = 1}, 0.35, Enum.EasingStyle.Back)
    else
        closePicker()
        modalBtn.Modal = false
        mouseRestore()
        tween(scale, {Scale = 0}, 0.2)
        task.delay(0.22, function()
            if not opened then main.Visible = false end
        end)
    end
end

