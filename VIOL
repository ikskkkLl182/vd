    opened = v
    if v then
        modalBtn.Modal = true
        main.Visible = true
        tween(scale, {Scale = menuScale}, 0.35, Enum.EasingStyle.Back)
    else
        closePicker()
        modalBtn.Modal = false
        mouseRestore()
        tween(scale, {Scale = 0}, 0.2)
        task.delay(0.22, function()
            if not opened then main.Visible = false end
        end)
    end
end

