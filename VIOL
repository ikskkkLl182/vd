--[[
  pups_trap_patch.lua — две замены в твоём pups-скрипте.
  1) [FIND] функцию `scFindZoneAngle` целиком  -> [REPLACE] блоком A (+ хелпер scRingRadius над ней)
  2) [FIND] функцию `scDumpCheck` целиком      -> [REPLACE] блоком B

  почему не находило: поиск метки считал радиус кольца от размера рамки Check (size*0.25..0.75).
  если Check больше самого кольца (или кольцо не на полкадра), метка на кольце вылетала из диапазона,
  finder возвращал nil -> скрипт падал на фиксированную точку trapZone = первая метка, для всех следующих
  проверок тыкал туда же. теперь радиус кольца берётся оттуда, где реально сидит стрелка (расстояние
  её элементов от оси вращения), метка ищется на этом радиусе.
]]

---------------------------------------------------------------------
-- блок A
---------------------------------------------------------------------
-- радиус кольца = как далеко от оси вращения сидят элементы стрелки; запас: size/2 рамки Check
local function scRingRadius(check)
    local c = visCenter(scN)
    local r = 0
    for _, d in ipairs(scN:GetDescendants()) do
        if d:IsA("GuiObject") and scGuiVisible(d) then
            r = math.max(r, (visCenter(d) - c).Magnitude)
        end
    end
    if r < 5 then
        r = math.min(check.AbsoluteSize.X, check.AbsoluteSize.Y) * 0.5
    end
    return r, c
end

local function scFindZoneAngle(force)
    local check = scN and scN.Parent
    if not (check and check:IsA("GuiObject")) then return nil end
    local R, c = scRingRadius(check)
    if R <= 0 then return nil end
    local now = os.clock()

    -- кэш: элемент ещё на экране и выглядит как метка
    local obj = scZoneObj
    if not force and obj and now - scZoneScanAt < 0.4
        and obj.Parent and obj:IsDescendantOf(game) and scGuiVisible(obj)
        and scVisKind(obj) == scZoneKind then
        return scAngle(visCenter(obj), c), obj, scZoneKind
    end

    -- весь skill check gui (метка может жить вне Check)
    local root = scN:FindFirstAncestorOfClass("ScreenGui") or check
    local best, bestScore, bestPt, bestKind = nil, -math.huge, nil, 0
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("GuiObject") and d ~= scN and not d:IsDescendantOf(scN) and scGuiVisible(d) then
            local kind = scVisKind(d)
            if kind > 0 then
                local sz = math.max(d.AbsoluteSize.X, d.AbsoluteSize.Y)
                if sz > 0 and sz <= R * 0.7 then            -- маленький элемент, не само кольцо
                    local pt = visCenter(d)
                    local dist = (pt - c).Magnitude
                    if dist >= R * 0.6 and dist <= R * 1.5 then   -- на кольце, не в центре
                        local area = d.AbsoluteSize.X * d.AbsoluteSize.Y
                        local score = kind * 1e6 - area          -- сплошной белый > контур, потом самый маленький
                        if score > bestScore then
                            best, bestScore, bestPt, bestKind = d, score, pt, kind
                        end
                    end
                end
            end
        end
    end
    scZoneObj, scZoneScanAt, scZoneKind = best, now, bestKind
    if best then return scAngle(bestPt, c), best, bestKind end
    return nil
end

---------------------------------------------------------------------
-- блок B: дамп с радиусом кольца, rel = расстояние/радиус, и содержимым Skillcheck-* в персонаже
-- (там может лежать угол зоны текущей проверки)
---------------------------------------------------------------------
local function scDumpCheck(why)
    local check = scN and scN.Parent
    if not check then
        scLog("[SC] dump: no skill check on screen")
        return
    end
    local root = scN:FindFirstAncestorOfClass("ScreenGui") or check
    local R, c = scRingRadius(check)
    local out = {}
    table.insert(out, string.format("[SC] check dump (%s): needle rot=%.0f goal rot=%.0f ringR=%.0f check=%.0fx%.0f",
        why, scN.Rotation, scZ and scZ.Rotation or 0, R, check.AbsoluteSize.X, check.AbsoluteSize.Y))
    local n = 0
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("GuiObject") then
            n = n + 1
            if n > 90 then
                table.insert(out, "  ...")
                break
            end
            local img = d:IsA("ImageLabel") or d:IsA("ImageButton")
            local col = img and d.ImageColor3 or d.BackgroundColor3
            local tr = img and d.ImageTransparency or d.BackgroundTransparency
            local name = (string.gsub(d:GetFullName(), "^.*SkillCheckPromptGui%.", ""))
            local rel = R > 0 and (visCenter(d) - c).Magnitude / R or 0
            table.insert(out, string.format("  %s [%s] vis=%s rot=%.0f pos=%.0f,%.0f size=%.0f,%.0f rel=%.2f col=%d,%d,%d tr=%.2f outline=%s kind=%d",
                name, d.ClassName, tostring(scGuiVisible(d)), d.Rotation,
                d.AbsolutePosition.X, d.AbsolutePosition.Y, d.AbsoluteSize.X, d.AbsoluteSize.Y, rel,
                math.floor(col.R * 255 + 0.5), math.floor(col.G * 255 + 0.5), math.floor(col.B * 255 + 0.5), tr,
                tostring(scIsOutline(d)), scVisKind(d)))
        end
    end
    local chr = player.Character
    if chr then
        for _, ch in ipairs(chr:GetChildren()) do
            if string.find(string.lower(ch.Name), "skillcheck", 1, true) then
                local at = {}
                for k, v in pairs(ch:GetAttributes()) do table.insert(at, k .. "=" .. tostring(v)) end
                table.insert(out, "  char." .. ch.Name .. " [" .. ch.ClassName .. "] attrs: " .. table.concat(at, ", "))
                for _, x in ipairs(ch:GetDescendants()) do
                    local val = x:IsA("ValueBase") and (" = " .. tostring(x.Value)) or ""
                    table.insert(out, "    " .. x.Name .. " [" .. x.ClassName .. "]" .. val)
                end
            end
        end
    end
    for _, line in ipairs(out) do pcall(print, line) end
    local copied = false
    if setclipboard then
        copied = (pcall(setclipboard, table.concat(out, "\n")))
    end
    scLog("[SC] dump: " .. #out .. " lines" .. (copied and ", copied to clipboard - paste it into the chat" or " (see console)"))
end

