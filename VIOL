local function addSlider(text, minV, maxV, defaultV, callback)
    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 54),
        BackgroundColor3 = THEME.item,
        BorderSizePixel = 0,
        LayoutOrder = nextOrder(),
    }, page)
