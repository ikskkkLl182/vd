-- unload
---------------------------------------------------------------------
env.__VDEspCleanup = function()
    saveColors()
    for k in pairs(ESP) do
        if k ~= "names" then ESP[k] = false end
    end
    espClear()

    SC.generator, SC.heal, SC.trap = false, false, false
    pcall(mouseRestore)

    for _, c in ipairs(connections) do
        pcall(function() c:Disconnect() end)
    end
    gui:Destroy()
    env.__VDEspCleanup = nil
end
