local function scStep(dt)
    if not (SC.generator or SC.heal) then
        scLast = nil
        scN, scZ = nil, nil
        scPrevCheckVisible = false
        return
    end

    scT = scT + dt
    local stale = (not scN) or (not scZ) or (not scN:IsDescendantOf(game)) or (not scZ:IsDescendantOf(game))
    if (stale and scT >= 0.2) or scT >= 2 then
        scT = 0
        scFindAll()
    end

    if stale or not scN or not scZ or not scGuiVisible(scN) then
        scLast, scPressed, scCtx, scStill = nil, false, nil, 0
        scPrevCheckVisible = false
        return
    end

    -- NEW: reset classification when a fresh skill check appears
    if not scPrevCheckVisible then
        scCtx = nil
        scPrevCheckVisible = true
    end

    local rot = scNorm(scN.Rotation)

    if scPressed then
        local waited = os.clock() - scPressTime
        local step = scLast and scDiff(rot, scLast) or 0
        local moved = scPressGoal and math.abs(scDiff(scZ.Rotation, scPressGoal)) > 0.5
        if math.abs(step) < 20 * math.max(dt, 0.001) then scStill = scStill + 1 else scStill = 0 end
        if (waited > 0.25 and (moved or math.abs(step) > 60 or step * scPressDir < -2 or scStill >= 3)) or waited > 0.8 then
            scPressed = false
            scStill = 0
        end
        scLast = rot
        return
    end

    if scLast == nil or dt <= 0 then
        scLast = rot
        scSeenAt = os.clock()
        return
    end

    local vel = scDiff(rot, scLast) / dt
    scLast = rot
    if math.abs(vel) < 20 then return end

    local ctx, rawId = scCtxFromChar()
    if not ctx then
        if scCtx == nil and (rawId or os.clock() - scSeenAt > 0.25) then
            scCtx = scCtxProximity() or "any"
        end
        ctx = scCtx
    end
    if not ctx then return end
    if ctx == "trap" then return end
    if ctx ~= "any" and not SC[ctx] then return end

    local perfect
    if ctx == "heal" then
        perfect = SC.healPerfect
    elseif ctx == "generator" then
        perfect = SC.genPerfect
    else
        -- "any" (couldn't tell): pick the toggle that is enabled
        if SC.heal and not SC.generator then
            perfect = SC.healPerfect
        else
            perfect = SC.genPerfect
        end
    end

    local center = perfect and SC_CFG.perfectCenter or SC_CFG.normalCenter
    local tol = perfect and SC_CFG.perfectTol or SC_CFG.normalTol
    local target = scZ.Rotation + center + SC_CFG.ghExtra

    local diffNow = scDiff(rot, target)
    local diffNext = scDiff(rot + vel * (SC_CFG.lead + dt), target)

    local dirNow = vel >= 0 and 1 or -1
    local late = diffNow * dirNow > 0 and diffNow * dirNow <= tol
    if (diffNow * diffNext <= 0 and math.abs(diffNow) < 40) or late then
        scPressed = true
        scPressTime = os.clock()
        scPressDir = dirNow
        scPressGoal = scZ.Rotation
        scPress()
    end
end
