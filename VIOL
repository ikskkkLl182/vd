        local d = input.Position - iconStartIn
        if d.Magnitude > 6 then
            iconMoved = true
        end
        if iconMoved then
            local cam = workspace.CurrentCamera
            local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
            local size = icon.AbsoluteSize
            local x = math.clamp(iconStartPos.X.Offset + d.X, 0, vp.X - size.X)
            local y = math.clamp(iconStartPos.Y.Offset + d.Y, 0, vp.Y - size.Y)
            icon.Position = UDim2.fromOffset(x, y)
        end
    end
end)

connect(UserInputService.InputEnded, function(input)
    if iconDown and isPointer(input) then
        iconDown = false
        if not iconMoved then
            setOpen(not opened)
        end
    end
end)

