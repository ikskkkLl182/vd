-- применить текущие цвета ко всем уже созданным объектам ESP
local function espApplyColors()
    for _, it in pairs(espItems) do
        local c
        if it.kind == "player" then
            c = it.killer and ESPColors.killer or ESPColors.survivors
        else
            c = ESPColors[it.cat]
        end
        if c then
            if it.hl then
                it.hl.FillColor = c
                it.hl.OutlineColor = c
            end
            it.lbl.TextColor3 = c
        end
    end
end

-- who is the killer: team name, attributes, or a "Killer" object in the character
local function espIsKiller(plr)
    local team = plr.Team
    if team and string.find(string.lower(team.Name), "kill", 1, true) then return true end

    local function check(inst)
        for _, name in ipairs({"Killer", "IsKiller", "killer", "Role", "role", "Team", "team"}) do
            local v = inst:GetAttribute(name)
            if v == true and string.find(string.lower(name), "kill", 1, true) then return true end
            if type(v) == "string" and string.find(string.lower(v), "kill", 1, true) then return true end
        end
        return false
    end

    if check(plr) then return true end
    local chr = plr.Character
    if chr then
        if check(chr) then return true end
        if chr:FindFirstChild("Killer") then return true end
    end
    return false
end

local function espRefreshPlayers()
    local alive = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and not string.find(plr.Team and string.lower(plr.Team.Name) or "", "spect", 1, true) then
            local killer = espIsKiller(plr)
            local want = (killer and ESP.killer) or ((not killer) and ESP.survivors)
            local chr = plr.Character
            local root = chr and chr:FindFirstChild("HumanoidRootPart")
            local hum = chr and chr:FindFirstChildOfClass("Humanoid")
            if want and chr and root and (not hum or hum.Health > 0) then
                alive[plr] = true
                local color = killer and ESPColors.killer or ESPColors.survivors
                local it = espItems[plr]
                if it and (it.chr ~= chr or it.killer ~= killer) then
                    espRemove(plr)
                    it = nil
                end
                if not it then
                    local hl = new("Highlight", {
                        Adornee = chr,
                        FillColor = color,
                        OutlineColor = color,
                        FillTransparency = 0.65,
                        OutlineTransparency = 0,
                        DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
                    }, espFolder)
                    local bb, lbl = espMakeTag(root, color)
                    espItems[plr] = {
                        kind = "player",
                        chr = chr,
                        killer = killer,
                        part = root,
                        hl = hl,
                        bb = bb,
                        lbl = lbl,
                        text = plr.DisplayName .. (killer and " (KILLER)" or ""),
                    }
                end
            end
        end
    end
    for key, it in pairs(espItems) do
        if it.kind == "player" and not alive[key] then
            espRemove(key)
        end
    end
end

local function espSet(flag, v)
    ESP[flag] = v
    espRefreshPlayers()
end

