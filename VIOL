-- ESP (highlights parented into the character / generator model)
---------------------------------------------------------------------
local ESP = {
    survivors = false,
    killer = false,
    generators = false,
    traps = false,
}

local function IsKiller(plr)
    return plr and plr.Team and plr.Team.Name == "Killer"
end

local function espUpdatePlayers()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local chr = plr.Character
            if chr then
                local killer = IsKiller(plr)
                local want = (killer and ESP.killer) or ((not killer) and ESP.survivors)
                local hl = chr:FindFirstChild("Independent_ESP")
                if want then
                    if not hl then
                        hl = new("Highlight", {
                            Name = "Independent_ESP",
                            FillTransparency = 0.5,
                            OutlineTransparency = 0,
                        }, chr)
                    end
                    local color = killer and ESPColors.killer or ESPColors.survivors
                    hl.FillColor = color
                    hl.OutlineColor = color
                elseif hl then
                    hl:Destroy()
                end
            end
        end
    end
end

local genHls = {}

local function genColor(model)
    local progress = model:GetAttribute("RepairProgress") or model:GetAttribute("ProgressRepair") or 0
    if type(progress) ~= "number" then progress = 0 end
    local pct = math.clamp(progress / 100, 0, 1)
    return ESPColors.generators:Lerp(ESPColors.generatorsdone, pct)
end

local function espUpdateGenerators()
    if not ESP.generators then
        for m, hl in pairs(genHls) do
            pcall(function() hl:Destroy() end)
            genHls[m] = nil
        end
        return
    end

    local map = workspace:FindFirstChild("Map")
    if not map then return end

    for _, d in ipairs(map:GetDescendants()) do
        if d:IsA("Model") and d.Name == "Generator" then
            local hl = genHls[d]
            if not (hl and hl.Parent) then
                hl = new("Highlight", {
                    Name = "Independent_Gen_ESP",
                    FillTransparency = 0.5,
                    OutlineTransparency = 0,
                }, d)
                genHls[d] = hl
            end
            local c = genColor(d)
            hl.FillColor = c
            hl.OutlineColor = c
        end
    end

    for m, hl in pairs(genHls) do
        if not m:IsDescendantOf(workspace) then
            pcall(function() hl:Destroy() end)
            genHls[m] = nil
        end
    end
end

-- traps: models whose name starts with "scp" anywhere in workspace.
-- the set is filled once at load (chunked) and kept up to date through DescendantAdded
local trapSet, trapHls = {}, {}

local function isTrapName(n)
    return string.match(string.lower(n), "^scp") ~= nil
end

task.spawn(function()
    local n = 0
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("Model") and isTrapName(d.Name) then trapSet[d] = true end
        n = n + 1
        if n % 2000 == 0 then task.wait() end
    end
end)

connect(workspace.DescendantAdded, function(d)
    if d:IsA("Model") and isTrapName(d.Name) then trapSet[d] = true end
end)

local function espUpdateTraps()
    if not ESP.traps then
        for m, hl in pairs(trapHls) do
            pcall(function() hl:Destroy() end)
            trapHls[m] = nil
        end
        return
    end
    for m in pairs(trapSet) do
        if m.Parent and m:IsDescendantOf(workspace) then
            local torso = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Torso") or m.PrimaryPart
            if torso then
                local hl = trapHls[m]
                if not (hl and hl.Parent) then
                    hl = new("Highlight", {
                        Name = "Combined_Trap_ESP",
                        FillTransparency = 0.5,
                        OutlineTransparency = 0,
                    }, m)
                    trapHls[m] = hl
                end
                hl.FillColor = ESPColors.traps
                hl.OutlineColor = ESPColors.traps
            end
        else
            trapSet[m] = nil
            if trapHls[m] then
                pcall(function() trapHls[m]:Destroy() end)
                trapHls[m] = nil
            end
        end
    end
end

---------------------------------------------------------------------
-- anti-loop: pallet / vault remotes
-- on enable: fires VaultEvent for every VaultTrigger and PalletSlideEvent for every PalletPointSlide
-- in the map, then watches PalletPoint parts: when one is renamed to PalletPointSlide it fires
-- PalletSlideEvent 0.1s later. A new Map (new round) is picked up automatically.
---------------------------------------------------------------------
local PAL = {block = false}
local palletConns, palletWatched, palletMap = {}, {}, nil

local function palletFireSlide(part)
    pcall(function()
        ReplicatedStorage.Remotes.Pallet.PalletSlideEvent:FireServer(part, true)
    end)
end

local function palletFireVault(part)
    pcall(function()
        ReplicatedStorage.Remotes.Window.VaultEvent:FireServer(part, true)
    end)
end

local function watchPallet(d)
    if palletWatched[d] then return end
    if d:IsA("BasePart") and d.Name == "PalletPoint" then
        palletWatched[d] = d:GetPropertyChangedSignal("Name"):Connect(function()
            if not PAL.block then return end
            if d.Name == "PalletPointSlide" then
                task.wait(0.1)
                palletFireSlide(d)
            end
        end)
    end
end

local function palletStop()
    for _, c in ipairs(palletConns) do pcall(function() c:Disconnect() end) end
    palletConns = {}
    for d, c in pairs(palletWatched) do
        pcall(function() c:Disconnect() end)
        palletWatched[d] = nil
    end
    palletMap = nil
end

local function palletInit(map)
    palletMap = map
    for _, d in ipairs(map:GetDescendants()) do
        if d.Name == "VaultTrigger" then palletFireVault(d) end
        if d.Name == "PalletPointSlide" and d:IsA("BasePart") then palletFireSlide(d) end
        watchPallet(d)
    end
    table.insert(palletConns, map.DescendantAdded:Connect(watchPallet))
end

local function palletTick()
    if not PAL.block then return end
    local map = workspace:FindFirstChild("Map")
    if map and map ~= palletMap then
        palletStop()
        palletInit(map)
    end
end

-- recolor existing highlights (color picker drag) without rescanning the map
local function espApplyColors()
    espUpdatePlayers()
    for m, hl in pairs(genHls) do
        if hl.Parent then
            local c = genColor(m)
            hl.FillColor = c
            hl.OutlineColor = c
        end
    end
    for _, hl in pairs(trapHls) do
        if hl.Parent then
            hl.FillColor = ESPColors.traps
            hl.OutlineColor = ESPColors.traps
        end
    end
end

local function espSet(flag, v)
    ESP[flag] = v
    pcall(espUpdatePlayers)
    pcall(espUpdateGenerators)
    pcall(espUpdateTraps)
end

local espT1, espT2 = 0, 0
connect(RunService.Heartbeat, function(dt)
    espT1 = espT1 + dt
    espT2 = espT2 + dt
    if espT1 >= 0.5 then
        espT1 = 0
        if ESP.survivors or ESP.killer then pcall(espUpdatePlayers) end
    end
    if espT2 >= 1.5 then
        espT2 = 0
        if ESP.generators then pcall(espUpdateGenerators) end
        if ESP.traps then pcall(espUpdateTraps) end
        if PAL.block then task.spawn(palletTick) end
    end
end)

---------------------------------------------------------------------
-- auto skill check: put the needle on the zone (+109) and press Space
---------------------------------------------------------------------
local SC = {
    auto = false,
}
local scBusy = false

connect(RunService.Heartbeat, function()
    if not SC.auto or scBusy then return end
    pcall(function()
        local g = playerGui:FindFirstChild("SkillCheckPromptGui") or playerGui:FindFirstChild("SkillCheckGui", true)
        if not g then return end
        if g:IsA("ScreenGui") and not g.Enabled then return end

        local check = g:FindFirstChild("Check") or g:FindFirstChild("Bar", true)
        if check and check.Visible then
            local line = check:FindFirstChild("Line") or g:FindFirstChild("Pointer", true)
            local goal = check:FindFirstChild("Goal") or g:FindFirstChild("Zone", true)
            if line and goal then
                line.Rotation = goal.Rotation + 109
                scBusy = true
                task.spawn(function()
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
                    task.wait(0.005)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
                    task.wait(0.05)
                    scBusy = false
                end)
            end
        end
    end)
end)

