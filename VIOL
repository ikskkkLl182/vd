-- trap skill check
-- the game reports a trap escape to the server like this (seen in the F9 log):
--   ReplicatedStorage.Remotes.Killers.<killer>.FreeTrap:FireServer("begin")
--   ReplicatedStorage.Remotes.Killers.<killer>.TrapSkillResult:FireServer("miss" | "good" | "perfect")  x N
--   ReplicatedStorage.Remotes.Killers.<killer>.FreeTrap:FireServer("commit")
-- a "miss" makes the client start over with a new "begin".
-- two layers work together:
--   1) the needle: while a trap escape is active the needle logic presses Space on the white zone mark
--      of EVERY check in the chain (the zone moves after each press, the needle keeps turning), so the
--      client itself sees a perfect check (works without any executor hooks). The press point corrects
--      itself after every press: the Space listener below measures where the needle really was when the
--      game received the key and moves the press point by the error.
--   2) the remote: the namecall hook (if the executor has it) tracks begin/commit and rewrites any grade the
--      client reports to "perfect"; if the client reports nothing for TRAP_TIMEOUT seconds while an escape
--      is active, "perfect" is sent directly
---------------------------------------------------------------------
local TRAP_RESULT_NAME = "TrapSkillResult"
local TRAP_FLOW_NAME = "FreeTrap"
local TRAP_GRADE = "perfect"
local TRAP_TIMEOUT = 3.5      -- seconds without a client report before pups reports by itself
local TRAP_INTERVAL = 1.2     -- minimum seconds between pups' own reports
local TRAP_ACTIVE_MAX = 30    -- forget "escape active" after this many seconds without a commit
local scTrapRemote = nil
local scTrapResultAt = 0
local scTrapActive = false
local scTrapActiveAt = 0
local scTrapLastFire = 0

-- wipe the file left by the earlier remote-learning version (it had the wrong remote saved)
if writefile and isfile then
    pcall(function()
        if isfile("vd_esp_trap_remote.json") then writefile("vd_esp_trap_remote.json", "{}") end
    end)
end

local function scSendTrapResult()
    local r = scTrapRemote
    if not (r and r.Parent) then
        r = nil
        local rs = game:GetService("ReplicatedStorage")
        for _, d in ipairs((rs:FindFirstChild("Remotes") or rs):GetDescendants()) do
            if d.Name == TRAP_RESULT_NAME and d:IsA("RemoteEvent") then
                r = d
                break
            end
        end
        scTrapRemote = r
    end
    if not r then return false end
    return (pcall(function() r:FireServer(TRAP_GRADE) end))
end

local scTrapNudge = 0       -- manual extra shift in degrees (the press point corrects itself, so this stays 0)
local scTrapPressed = false -- we pressed for a trap check and wait for its grade
local scLastPressSpoof = false
local scSpoofFails = 0
local scSpoofToggle = nil   -- menu toggle, set below

local function scTrapGrade(grade)
    if scTrapPressed then
        scTrapPressed = false
        scLog("[SC] trap: our press was graded", grade, scLastPressSpoof and "(spoof)" or "(timing)")
        if scLastPressSpoof then
            if grade == "perfect" then
                scSpoofFails = 0
            else
                scSpoofFails = scSpoofFails + 1
                if scSpoofFails >= 2 then
                    scSpoofFails = 0
                    SC.trapSpoof = false
                    task.spawn(function()
                        if scSpoofToggle then scSpoofToggle.set(false) end
                    end)
                    scLog("[SC] trap: spoof gave no perfect twice -> switched to needle timing")
                end
            end
        end
    else
        scLog("[SC] trap: client graded", grade, "without our press")
    end
end

local scHookOk = false
if hookmetamethod and checkcaller and getnamecallmethod then
    local oldNC
    scHookOk = pcall(function()
        oldNC = hookmetamethod(game, "__namecall", (newcclosure or function(f) return f end)(function(self, ...)
            local method = getnamecallmethod()
            if scOutAlive and method == "FireServer" and not checkcaller() and typeof(self) == "Instance" then
                local name = self.Name
                if name == TRAP_FLOW_NAME then
                    local step = ...
                    if step == "begin" then
                        scTrapActive = true
                        scTrapActiveAt = os.clock()
                        scTrapLatchUntil = os.clock() + 6
                        if SC.trap then scLog("[SC] trap escape begin") end
                    elseif step == "commit" then
                        scTrapActive = false
                        scTrapLatchUntil = 0
                        if SC.trap then scLog("[SC] trap escape commit") end
                    end
                elseif name == TRAP_RESULT_NAME then
                    scTrapRemote = self
                    scTrapResultAt = os.clock()
                    if SC.trap then
                        local grade = ...
                        if type(grade) == "string" then
                            scTrapGrade(grade)
                            scLog("[SC] trap result", grade, "->", TRAP_GRADE)
                            if setnamecallmethod then setnamecallmethod(method) end
                            return oldNC(self, TRAP_GRADE, select(2, ...))
                        end
                    end
                end
            end
            return oldNC(self, ...)
        end))
    end)
end
if not scHookOk then
    scLog("[SC] trap: hookmetamethod / checkcaller / getnamecallmethod unavailable - trap uses the needle only")
end

-- Spoof: while a trap press is in flight, anything but pups that reads Line.Rotation gets the angle of the
-- zone mark instead of the real needle angle, so the game grades the press perfect whatever the timing
-- (the same way the game reads the needle for generator checks). Active for 0.35 s after each press only.
local scSpoofAngle, scSpoofAt = nil, 0
local scIndexOld = nil
if hookmetamethod and checkcaller and newcclosure then
    pcall(function()
        scIndexOld = hookmetamethod(game, "__index", newcclosure(function(self, key)
            if scSpoofAngle and self == scN and key == "Rotation" and scOutAlive
                and os.clock() - scSpoofAt < 0.35 and not checkcaller() then
                local real = scIndexOld(self, key)
                -- keep the same "lap" as the real value, in case the game does not normalise angles
                return scSpoofAngle + 360 * math.floor((real - scSpoofAngle) / 360 + 0.5)
            end
            return scIndexOld(self, key)
        end))
    end)
end
local scSpoofReady = scIndexOld ~= nil
if not scSpoofReady then
    scLog("[SC] trap: __index hook unavailable - spoof off, using needle timing")
end

-- trapped state: escape flow seen by the hook, or an attribute on the character / player
local function scIsTrapped()
    if scTrapActive and os.clock() - scTrapActiveAt < TRAP_ACTIVE_MAX then
        return true
    end
    local chr = player.Character
    for _, n in ipairs({"Trapped", "EscapingTrap", "InTrap", "Caught", "Stuck"}) do
        if (chr and chr:GetAttribute(n) == true) or player:GetAttribute(n) == true then
            return true
        end
    end
    return false
end

-- fallback: the client reported nothing for a while during an escape -> report perfect ourselves
local function scTrapTick()
    if not scTrapActive then return end
    local now = os.clock()
    if now - scTrapActiveAt > TRAP_ACTIVE_MAX then
        scTrapActive = false
        return
    end
    local quiet = now - math.max(scTrapResultAt, scTrapActiveAt)
    if quiet > TRAP_TIMEOUT and now - scTrapLastFire > TRAP_INTERVAL then
        scTrapLastFire = now
        if scSendTrapResult() then scLog("[SC] trap result sent (client reported none)") end
    end
end

-- fallback: nearest object
local function scCtxProximity()
    local chr = player.Character
    local root = chr and chr:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local pos = root.Position

    local bestKind, bestDist = nil, math.huge
    local function consider(kind, dist, range)
        if dist <= range and dist < bestDist then
            bestKind, bestDist = kind, dist
        end
    end

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and string.lower(obj.Name) == "generator" and not obj:FindFirstChildOfClass("Humanoid") then
            local ok, cf = pcall(function() return obj:GetPivot() end)
            if ok then consider("generator", (cf.Position - pos).Magnitude, SC_CFG.genRange) end
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and not espIsKiller(plr) then
            local r = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
            if r then consider("heal", (r.Position - pos).Magnitude, SC_CFG.playerRange) end
        end
    end

    return bestKind
end

-- VirtualInputManager first (real input), firesignal only if VIM is missing / failed
local function scPress()
    scAutoUntil = os.clock() + 0.2
    task.spawn(function()
        local sent = false
        if VirtualInputManager then
            sent = pcall(function()
                VirtualInputManager:SendKeyEvent(true, SC_CFG.key, false, game)
                task.wait(0.03)
                VirtualInputManager:SendKeyEvent(false, SC_CFG.key, false, game)
            end)
        end
        if not sent and firesignal then
            pcall(function()
                firesignal(UserInputService.InputBegan, {
                    KeyCode = SC_CFG.key,
                    UserInputType = Enum.UserInputType.Keyboard,
                }, false)
            end)
        end
        if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled and scB and firesignal then
            pcall(function() firesignal(scB.MouseButton1Down) end)
            pcall(function() firesignal(scB.MouseButton1Click) end)
            pcall(function() firesignal(scB.Activated) end)
        end
    end)
end

-- Self-calibration of the trap press point.
-- The key reaches the game some milliseconds after we send it, and the needle keeps moving meanwhile.
-- When the game receives our Space, this listener reads where the needle really is, compares it with the
-- centre of the zone we aimed at, and moves the press point by that error (the value is kept between
-- re-executions in env.__VDTrapOffset).
connect(UserInputService.InputBegan, function(input)
    if input.KeyCode ~= SC_CFG.key or not scEvalPending then return end
    local ev = scEvalPending
    if os.clock() - ev.t > 0.6 then
        scEvalPending = nil
        return
    end
    if not (scN and scN.Parent) then return end
    scEvalPending = nil
    local ang = scNorm(scN.Rotation)
    local err = ev.dir * scDiff(ang, ev.zone) -- > 0: the needle was already past the zone centre (too late)
    local before = scTrapOffset
    -- small errors are noise: move gently; large errors: move almost fully
    local gain = math.abs(err) > 6 and 0.9 or 0.6
    scTrapOffset = math.clamp(scTrapOffset - err * gain, -6, 40)
    env.__VDTrapOffset = scTrapOffset
    scLog(string.format("[SC] trap: key landed %.1f deg %s the zone centre | press point %.1f -> %.1f",
        math.abs(err), err > 0 and "after" or "before", before, scTrapOffset))
end)

connect(player.CharacterAdded, scReset)
do
    local pg0 = player:FindFirstChild("PlayerGui")
    if pg0 then connect(pg0.ChildAdded, scReset) end
end

local function scStep(dt)
    if SC.trap then scTrapTick() end

    if not (SC.generator or SC.heal or SC.trap) then
        scLast = nil
        scN, scZ = nil, nil
        return
    end

    scT = scT + dt
    local stale = (not scN) or (not scZ) or (not scN:IsDescendantOf(game)) or (not scZ:IsDescendantOf(game))
    if (stale and scT >= 0.2) or scT >= 2 then
        scT = 0
        scFindAll()
    end

    if stale or not scN or not scZ or not scGuiVisible(scN) then
        scLast, scPressed, scCtx, scLastG, scPrevLV, scStill = nil, false, nil, nil, nil, 0
        scWasMoving = false
        scLastZone, scZoneSame, scPressZone, scZoneObj = nil, 0, nil, nil
        scNoZoneDumped = false
        return
    end

    local rot = scNorm(scN.Rotation)

    if scPressed then
        -- new skill check in a chain (the gui stays up, the needle keeps turning): the zone mark jumped to a new
        -- place, or the needle jumped / went back / stopped, or timeout
        local waited = os.clock() - scPressTime
        local step = scLast and scDiff(rot, scLast) or 0
        local moved = scPressGoal and math.abs(scDiff(scZ.Rotation, scPressGoal)) > 0.5
        if scPressSrcFn and scPressSrcV then
            local v = scPressSrcFn()
            moved = moved or (v ~= nil and math.abs(scDiff(v, scPressSrcV)) > 1.5)
        end
        local zoneMoved = false
        if scPressZone and waited > 0.04 then
            local za = scFindZoneAngle(true)
            if za and math.abs(scDiff(za, scPressZone)) > 4 then zoneMoved = true end
        end
        if math.abs(step) < 20 * math.max(dt, 0.001) then scStill = scStill + 1 else scStill = 0 end
        if zoneMoved or (waited > 0.25 and (moved or math.abs(step) > 60 or step * scPressDir < -2 or scStill >= 3)) or waited > 0.8 then
            if zoneMoved then scLog("[SC] trap: next check started") end
            scPressed = false
            scStill = 0
            scPrevLV, scLastG = nil, nil
            scLastZone, scZoneSame, scPressZone = nil, 0, nil
            scNoZoneDumped = false
            scReleasedAt = os.clock()
            scMoveStart = scReleasedAt
        end
        scLast = rot
        return
    end

    if scLast == nil or dt <= 0 then
        scLast = rot
        scSeenAt = os.clock()
        return
    end

    local vel = scDiff(rot, scLast) / dt
    scLast = rot
    if math.abs(vel) < 20 then scLastG = nil scWasMoving = false return end -- needle is not moving yet
    if not scWasMoving then
        scWasMoving = true
        scMoveStart = os.clock()
    end

    -- which skill check: trapped state first, then the character id, then (sticky) trap latch, then proximity
    local ctx, rawId = scCtxFromChar()
    if scIsTrapped() then
        ctx = "trap"
    elseif ctx == "trap" then
        -- the id says trap
    elseif not ctx and os.clock() < scTrapLatchUntil then
        ctx = "trap" -- between two checks of one escape the id may be gone for a moment
    else
        if not ctx and scCtx == nil and (rawId or os.clock() - scSeenAt > 0.25) then
            scCtx = scCtxProximity() or "any"
        end
        ctx = ctx or scCtx
    end
    if ctx == "trap" then scTrapLatchUntil = os.clock() + 6 end
    if not ctx then return end
    if ctx ~= "any" and not SC[ctx] then return end

    local cur, curVel, target, srcFn, tag = rot, vel, nil, nil, ctx
    local perfect = true
    local zoneNow = nil

    local tol
    if ctx == "trap" then
        -- trap checks are always pressed on the perfect zone. every check of the chain has its own zone,
        -- so the zone mark is read from the gui; the press point is measured along the needle travel
        -- direction, so it works whichever way the needle turns
        perfect = true
        local dirSign = vel >= 0 and 1 or -1
        local za, zobj, zkind = scFindZoneAngle(false)
        if za then
            scZoneEverFound = true
            scNoZoneDumped = false
            if scLastZone and math.abs(scDiff(za, scLastZone)) < 1.5 then
                scZoneSame = scZoneSame + 1
            else
                scZoneSame = 0
                scLog(string.format("[SC] trap zone at %.0f (needle %.0f) %s: %s", za, rot,
                    ({"visible", "outline", "solid"})[zkind] or "?", zobj and zobj.Name or "?"))
            end
            scLastZone = za
            if scZoneSame < 2 then return end                  -- wait until the zone stopped moving
            if os.clock() - scPressTime < 0.2 then return end  -- never press twice in a row
            zoneNow = za

            if SC.trapSpoof and scSpoofReady then
                if os.clock() - scMoveStart < 0.15 then return end -- the check has only just started
                scSpoofAngle, scSpoofAt = za, os.clock()
                scLog(string.format("[SC] press trap(spoof) zone=%.0f needle=%.0f vel=%d", za, rot, math.floor(vel)))
                scTrapPressed = true
                scLastPressSpoof = true
                scPressZone = za
                scZoneObj = nil
                scEvalPending = nil
                scPressed = true
                scPressTime = os.clock()
                scPressDir = vel >= 0 and 1 or -1
                scPressGoal = scZ.Rotation
                scPressSrcFn, scPressSrcV = nil, nil
                scPress()
                return
            end

            target = za + dirSign * (scTrapOffset + scTrapNudge)
            tag = "trap(zone)"
        elseif scZoneEverFound or os.clock() - scMoveStart < 1.0 then
            -- zone mark not visible (yet): wait. If it stays missing, dump what is on screen once per check
            -- so the structure can be read in F9 (no silent stall)
            if os.clock() - scMoveStart > 0.8 and not scNoZoneDumped then
                scNoZoneDumped = true
                scLog("[SC] trap: zone mark not found for this check - dump below")
                scDumpCheck("zone mark not found")
            end
            return
        else
            target = scZ.Rotation + dirSign * (SC_CFG.trapZone + scTrapNudge)
            tag = "trap(fixed)"
            if not scTrapWarned then
                scTrapWarned = true
                scLog("[SC] trap: zone mark not found - using the fixed point (only right for the first check)")
                scDumpCheck("zone mark not found")
            end
        end
        tol = SC_CFG.trapTol
    else
        if ctx == "heal" then
            perfect = SC.healPerfect
        else
            perfect = SC.genPerfect
        end
        local center = perfect and SC_CFG.perfectCenter or SC_CFG.normalCenter
        target = scZ.Rotation + center + SC_CFG.ghExtra
    end

    tol = tol or (perfect and SC_CFG.perfectTol or SC_CFG.normalTol)
    local diffNow = scDiff(cur, target)
    local diffNext = scDiff(cur + curVel * (SC_CFG.lead + dt), target)

    -- press when the needle crosses the target on the next frame or is already inside tolerance
    local dirNow = curVel >= 0 and 1 or -1
    local late = diffNow * dirNow > 0 and diffNow * dirNow <= tol
    if (diffNow * diffNext <= 0 and math.abs(diffNow) < 40) or late then
        scLog("[SC] press", tag, perfect and "perfect" or "normal", "id=" .. tostring(rawId),
            "cur=" .. math.floor(cur), "target=" .. math.floor(target), "goal=" .. math.floor(scZ.Rotation), "vel=" .. math.floor(curVel),
            ctx == "trap" and ("offset=" .. string.format("%.1f", scTrapOffset)) or "")
        if ctx == "trap" then
            scTrapPressed = true
            scLastPressSpoof = false
            scPressZone = zoneNow
            scZoneObj = nil -- look for the zone mark again after the press
            -- let the Space listener measure how far from the zone centre the key really landed
            scEvalPending = zoneNow and {zone = zoneNow, dir = vel >= 0 and 1 or -1, t = os.clock()} or nil
        end
        scPressed = true
        scPressTime = os.clock()
        scPressDir = vel >= 0 and 1 or -1
        scPressGoal = scZ.Rotation
        scPressSrcFn = srcFn
        scPressSrcV = srcFn and srcFn() or nil
        scPress()
    end
end

