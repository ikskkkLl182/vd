local connections = {}
local function connect(signal, fn)
    local c = signal:Connect(fn)
    table.insert(connections, c)
    return c
end

local THEME = {
    bg = Color3.fromRGB(14, 14, 22),
    panel = Color3.fromRGB(21, 21, 33),
    item = Color3.fromRGB(30, 30, 46),
    hover = Color3.fromRGB(44, 44, 66),
    text = Color3.fromRGB(235, 235, 245),
    dim = Color3.fromRGB(140, 140, 165),
    accent = Color3.fromRGB(140, 90, 255),
    accent2 = Color3.fromRGB(60, 200, 255),
    off = Color3.fromRGB(58, 58, 80),
    danger = Color3.fromRGB(255, 80, 100),
}

local function new(class, props, parent)
    local inst = Instance.new(class)
    if props then
        for k, v in pairs(props) do
            inst[k] = v
        end
    end
    if parent then
        inst.Parent = parent
    end
    return inst
end

local function corner(obj, radius)
    return new("UICorner", {CornerRadius = UDim.new(0, radius)}, obj)
end

local function tween(obj, props, time, style)
    TweenService:Create(
        obj,
        TweenInfo.new(time or 0.25, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        props
    ):Play()
end

local function isPointer(input)
    return input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
end

local function isMove(input)
    return input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
end

local layoutCounter = 0
local function nextOrder()
    layoutCounter = layoutCounter + 1
    return layoutCounter
end

