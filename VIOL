-- log: console + the "Log" box in the menu (many executors send print() of scripts to their own console,
-- not to F9, so the menu box is the reliable place to read it)
local scLogLines, scLogAll, scLogLabel = {}, {}, nil
local function scLog(...)
    local parts = {}
    for i = 1, select("#", ...) do
        parts[i] = tostring((select(i, ...)))
    end
    local line = table.concat(parts, " ")
    pcall(print, line)
    table.insert(scLogAll, line)
    if #scLogAll > 300 then table.remove(scLogAll, 1) end
    table.insert(scLogLines, line)
    if #scLogLines > 12 then table.remove(scLogLines, 1) end
    if scLogLabel then
        pcall(function() scLogLabel.Text = table.concat(scLogLines, "\n") end)
    end
end

local SC = {
    generator = false,
    heal = false,
    genPerfect = true,   -- generators: true = perfect (white zone), false = normal
    healPerfect = true,  -- healing:    true = perfect (white zone), false = normal
    trap = false,        -- trap release (always perfect)
    trapSpoof = true,    -- trap: hand the game the zone angle when it reads the needle (any press = perfect)
