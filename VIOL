connect(UserInputService:GetPropertyChangedSignal("MouseIconEnabled"), function()
    if opened and mouseForced and UserInputService.MouseIconEnabled == false then
        gameIcon = false
    end
end)

local function mouseRestore()
    if not mouseForced then return end
    mouseForced = false
    local behavior = gameBehavior or prevMouseBehavior
    local iconOn = prevMouseIcon
    if gameIcon ~= nil then iconOn = gameIcon end
    gameBehavior, gameIcon = nil, nil
    if player.CameraMode == Enum.CameraMode.LockFirstPerson then
        behavior = Enum.MouseBehavior.LockCenter
        iconOn = false
    end
    UserInputService.MouseIconEnabled = iconOn
    UserInputService.MouseBehavior = behavior
end

