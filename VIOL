---------------------------------------------------------------------
-- dragging (menu window)
---------------------------------------------------------------------
local dragging, dragStart, startPos = false, nil, nil

connect(topbar.InputBegan, function(input)
    if isPointer(input) then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
    end
end)

connect(UserInputService.InputChanged, function(input)
    if dragging and isMove(input) then
        local d = input.Position - dragStart
        main.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + d.X,
            startPos.Y.Scale, startPos.Y.Offset + d.Y
        )
    end
end)

connect(UserInputService.InputEnded, function(input)
    if isPointer(input) then
        dragging = false
    end
end)

local maintenanceTimer = 0
connect(RunService.RenderStepped, function(dt)
    maintenanceTimer = maintenanceTimer + dt
    if maintenanceTimer >= 0.5 then
        maintenanceTimer = 0
        ensureMounted()
        speedApply()
    end

    local rot = (os.clock() * 80) % 360
    strokeGrad.Rotation = rot
    iconGrad.Rotation = rot

    if opened then
        mouseRelease()
        if not UserInputService.MouseIconEnabled then
            UserInputService.MouseIconEnabled = true
        end
        if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        end
    end

    pcall(scStep, dt)
end)

---------------------------------------------------------------------
-- unload
---------------------------------------------------------------------
env.__VDEspCleanup = function()
    saveColors()
    saveUi()
    for k in pairs(ESP) do
        if k ~= "names" then ESP[k] = false end
    end
    espClear()

    SC.enabled = false
    SPEED.enabled = false
    pcall(speedApply)
    pcall(mouseRestore)

    for _, c in ipairs(connections) do
        pcall(function() c:Disconnect() end)
    end
    gui:Destroy()
    env.__VDEspCleanup = nil
end
