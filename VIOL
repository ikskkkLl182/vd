local function addToggle(text, default, callback, bindId, defaultKey)
    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = THEME.item,
        BorderSizePixel = 0,
        LayoutOrder = nextOrder(),
    }, page)
    corner(row, 8)

    new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(14, 0),
        Size = UDim2.new(1, bindId and -158 or -80, 1, 0),
        Font = Enum.Font.GothamMedium,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = THEME.text,
        Text = text,
    }, row)

    local track = new("Frame", {
        Size = UDim2.fromOffset(44, 22),
        Position = UDim2.new(1, -58, 0.5, -11),
        BackgroundColor3 = THEME.off,
        BorderSizePixel = 0,
    }, row)
    corner(track, 11)

    local knob = new("Frame", {
        Size = UDim2.fromOffset(16, 16),
        Position = UDim2.fromOffset(3, 3),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
    }, track)
    corner(knob, 8)

    local click = new("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
    }, row)

    local state = default and true or false
    local obj = {}

    local function render()
        tween(track, {BackgroundColor3 = state and THEME.accent or THEME.off}, 0.2)
        tween(knob, {Position = state and UDim2.fromOffset(25, 3) or UDim2.fromOffset(3, 3)}, 0.2, Enum.EasingStyle.Back)
    end

    function obj.set(v)
        state = v and true or false
        render()
        pcall(callback, state)
    end

    function obj.get()
        return state
    end

    connect(click.Activated, function()
        obj.set(not state)
    end)

    if bindId then
        registerBind(bindId, defaultKey, function()
            obj.set(not state)
        end)
        makeBindButton(row, bindId, UDim2.new(1, -136, 0.5, -12))
    end

    render()
    return obj
end

