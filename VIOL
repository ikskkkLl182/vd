local function scActive()
    return SC.generator or SC.heal or SC.trap
end

local function scStep(dt)
    if not scActive() then
        scLast = nil
        scN, scZ = nil, nil
        return
    end

    scT = scT + dt
    local stale = (not scN) or (not scZ) or (not scN:IsDescendantOf(game)) or (not scZ:IsDescendantOf(game))
    if (stale and scT >= 0.2) or scT >= 2 then
        scT = 0
        scFindAll()
    end

    if stale or not scN or not scZ or not scGuiVisible(scN) then
        scLast, scPressed, scCtx, scLastG, scHinted, scPrevLV = nil, false, nil, nil, false, nil
        return
    end

    local rot = scNorm(scN.Rotation)

    if scPressed then
        -- новый скилчек в цепочке (капкан даёт несколько подряд, gui при этом не скрывается):
        -- зона сменила угол, стрелка прыгнула/пошла назад, или вышел таймаут
        local waited = os.clock() - scPressTime
        local step = scLast and scDiff(rot, scLast) or 0
        local moved = scPressGoal and math.abs(scDiff(scZ.Rotation, scPressGoal)) > 0.5
        if scPressSrcFn and scPressSrcV then
            local v = scPressSrcFn()
            moved = moved or (v ~= nil and math.abs(scDiff(v, scPressSrcV)) > 1.5)
        end
        if (waited > 0.25 and (moved or math.abs(step) > 60 or step * scPressDir < -2)) or waited > 0.8 then
            scPressed = false
        end
        scLast = rot
        return
    end

    if scLast == nil or dt <= 0 then
        scLast = rot
        scSeenAt = os.clock()
        return
    end

    local vel = scDiff(rot, scLast) / dt
    scLast = rot
    if math.abs(vel) < 20 then scLastG = nil return end -- стрелка ещё не движется

    -- что за скилчек: сначала точно (по персонажу), потом по близости
    local ctx, rawId = scCtxFromChar()
    if not ctx and scCtx == nil and (rawId or os.clock() - scSeenAt > 0.25) then
        scCtx = scCtxProximity() or "any"
    end
    ctx = ctx or scCtx
    if not ctx then return end
    if ctx ~= "any" and not SC[ctx] then return end

    local cur, curVel, target, srcFn, tag = rot, vel, nil, nil, ctx

    if ctx == "trap" then
        local src = SC_LEARN.src
        local lv = src and scLearnVal() or nil
        if lv then
            -- выученный источник зоны (по твоим ручным попаданиям)
            -- первый скилчек цепочки: значение источника ещё может быть от прошлой зоны -> ждём, пока устоится
            local stable = scPrevLV ~= nil and math.abs(scDiff(lv, scPrevLV)) < 0.5
            scPrevLV = lv
            if not stable or os.clock() - scSeenAt < 0.12 then return end
            if src.kind == "G" or src.kind == "T" then
                local check, c, size = scBase()
                local ns = check and scTipAngle(c, size)
                if not ns then return end
                local g = scLastG
                scLastG = ns
                if not g then return end
                cur, curVel = ns, scDiff(ns, g) / dt
                if math.abs(curVel) < 20 then return end
            end
            target = scNorm(src.sign * lv + src.off)
            if not SC.perfect then
                -- обычное попадание: дальше идеала по ходу стрелки
                target = target + (SC_CFG.normalCenter - SC_CFG.perfectCenter) * (curVel >= 0 and 1 or -1)
            end
            srcFn = scLearnVal
            tag = "trap(learn)"
        elseif math.abs(scDiff(scZ.Rotation, 0)) <= 0.5 then
            -- Goal мёртвый (всегда 0): зону берём с экрана по белому квадрату
            local zs, ns = scGeom()
            if not (zs and ns) then
                if not scHinted then
                    scHinted = true
                    warn("[SC] trap: источник зоны неизвестен. жми Space руками в идеал " .. SC_CFG.learnMin .. "+ раз - скрипт научится")
                end
                return
            end
            local g = scLastG
            scLastG = ns
            if not g then return end
            cur, curVel = ns, scDiff(ns, g) / dt
            if math.abs(curVel) < 20 then return end
            target = (zs + SC_CFG.trapGeoD) % 360
            srcFn = function() return (scGeom()) end
            tag = "trap(geo)"
        end
    end

    if not target then
        local center = SC.perfect and SC_CFG.perfectCenter or SC_CFG.normalCenter
        local sign, shift = 1, 0
        local extra = SC_CFG.ghExtra -- гены / лечение / "any"
        if ctx == "trap" then
            sign, shift, extra = SC_CFG.trapSign, SC_CFG.trapShift, SC_CFG.trapExtra
        end
        target = scZ.Rotation + shift + sign * (center + extra)
    end

    local diffNow = scDiff(cur, target)
    local diffNext = scDiff(cur + curVel * (SC_CFG.lead + dt), target)

    -- нажимаем, когда стрелка в следующем кадре пересечёт цель или окажется в допуске
    local dirNow = curVel >= 0 and 1 or -1
    local late = diffNow * dirNow > 0 and diffNow * dirNow <= (SC.perfect and SC_CFG.perfectTol or SC_CFG.normalTol)
    if (diffNow * diffNext <= 0 and math.abs(diffNow) < 40) or late then
        print("[SC] press", tag, "id=" .. tostring(rawId), "cur=" .. math.floor(cur), "target=" .. math.floor(target), "goal=" .. math.floor(scZ.Rotation), "vel=" .. math.floor(curVel))
        scPressed = true
        scPressTime = os.clock()
        scPressDir = vel >= 0 and 1 or -1
        scPressGoal = scZ.Rotation
        scPressSrcFn = srcFn
        scPressSrcV = srcFn and srcFn() or nil
        scPress()
    end
end

local function scDump()
    print("[SC] dump через 3 секунды - запусти скилчек!")
    task.delay(3, function()
        local pg = player:FindFirstChild("PlayerGui")
        if not pg then return end
        print("---- SC dump ----")
        local chr = player.Character
        if chr then
            local names = {}
            for _, c in ipairs(chr:GetChildren()) do
                table.insert(names, c.Name)
            end
            print("character children:", table.concat(names, ", "))
        end
        for _, g in ipairs(pg:GetChildren()) do
            if g ~= gui and g:IsA("ScreenGui") and g.Enabled then
                local matched = scMatch(g.Name, SC_CFG.guiWords)
                print("ScreenGui:", g.Name, matched and "(match)" or "")
                if matched then
                    for _, d in ipairs(g:GetDescendants()) do
                        if d:IsA("GuiObject") then
                            print("  ", d:GetFullName(), d.ClassName, "vis:", scGuiVisible(d), "rot:", d.Rotation, "size:", d.AbsoluteSize)
                        elseif d:IsA("UIGradient") then
                            print("  ", d:GetFullName(), d.ClassName, "rot:", d.Rotation, "offset:", d.Offset)
                        end
                    end
                end
            end
        end
        print("context(char):", scCtxFromChar(), "| context(near):", scCtxProximity())
        print("learned:", SC_LEARN.src and (SC_LEARN.src.kind .. ":" .. SC_LEARN.src.path) or "none")
        print("---- end ----")
    end)
end

