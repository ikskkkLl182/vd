local COLOR_FILE = "vd_esp_colors.json"

local DEFAULT_COLORS = {
    survivors = Color3.fromRGB(80, 255, 130),
    killer = Color3.fromRGB(255, 60, 60),
    generators = Color3.fromRGB(255, 220, 60),
}

local ESPColors = {}
for k, v in pairs(DEFAULT_COLORS) do
    ESPColors[k] = v
end

if readfile and isfile then
    pcall(function()
        if isfile(COLOR_FILE) then
            local decoded = HttpService:JSONDecode(readfile(COLOR_FILE))
            if type(decoded) == "table" then
                for k, t in pairs(decoded) do
                    if DEFAULT_COLORS[k] and type(t) == "table" and #t == 3 then
                        ESPColors[k] = Color3.fromRGB(t[1], t[2], t[3])
                    end
                end
            end
        end
    end)
end

local function saveColors()
    if not writefile then return end
    local data = {}
    for k, c in pairs(ESPColors) do
        data[k] = {
            math.floor(c.R * 255 + 0.5),
            math.floor(c.G * 255 + 0.5),
            math.floor(c.B * 255 + 0.5),
        }
    end
    pcall(function()
        writefile(COLOR_FILE, HttpService:JSONEncode(data))
    end)
end

