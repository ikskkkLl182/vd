local espFolder = new("Folder", {Name = "ESP"}, gui)

local ESP = {
    survivors = false,
    killer = false,
    generators = false,
    names = true,
}

local espItems = {}

local function espRemove(key)
    local it = espItems[key]
    if not it then return end
    espItems[key] = nil
    pcall(function() if it.hl then it.hl:Destroy() end end)
    pcall(function() it.bb:Destroy() end)
end

local function espClear(filter)
    for key, it in pairs(espItems) do
        if not filter or filter(it) then
            espRemove(key)
        end
    end
end

local function espMakeTag(part, color)
    local bb = new("BillboardGui", {
        Adornee = part,
        AlwaysOnTop = true,
        Size = UDim2.fromOffset(150, 22),
        StudsOffset = Vector3.new(0, 3, 0),
        LightInfluence = 0,
        ResetOnSpawn = false,
    }, espFolder)
    local lbl = new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextColor3 = color,
        TextStrokeTransparency = 0.3,
        Text = "",
    }, bb)
    return bb, lbl
end

-- apply current colors to all existing ESP objects
local function espApplyColors()
    for _, it in pairs(espItems) do
        local c
        if it.kind == "player" then
            c = it.killer and ESPColors.killer or ESPColors.survivors
        else
            c = ESPColors[it.cat]
        end
        if c then
            if it.hl then
                it.hl.FillColor = c
                it.hl.OutlineColor = c
            end
            it.lbl.TextColor3 = c
        end
    end
end

-- who is the killer: team name, attributes, or a "Killer" object in the character
local function espIsKiller(plr)
    local team = plr.Team
    if team and string.find(string.lower(team.Name), "kill", 1, true) then return true end

    local function check(inst)
        for _, name in ipairs({"Killer", "IsKiller", "killer", "Role", "role", "Team", "team"}) do
            local v = inst:GetAttribute(name)
            if v == true and string.find(string.lower(name), "kill", 1, true) then return true end
            if type(v) == "string" and string.find(string.lower(v), "kill", 1, true) then return true end
        end
        return false
    end

    if check(plr) then return true end
    local chr = plr.Character
    if chr then
        if check(chr) then return true end
        if chr:FindFirstChild("Killer") then return true end
    end
    return false
end

local function espRefreshPlayers()
    local alive = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and not string.find(plr.Team and string.lower(plr.Team.Name) or "", "spect", 1, true) then
            local killer = espIsKiller(plr)
            local want = (killer and ESP.killer) or ((not killer) and ESP.survivors)
            local chr = plr.Character
            local root = chr and chr:FindFirstChild("HumanoidRootPart")
            local hum = chr and chr:FindFirstChildOfClass("Humanoid")
            if want and chr and root and (not hum or hum.Health > 0) then
                alive[plr] = true
                local color = killer and ESPColors.killer or ESPColors.survivors
                local it = espItems[plr]
                if it and (it.chr ~= chr or it.killer ~= killer) then
                    espRemove(plr)
                    it = nil
                end
                if not it then
                    local hl = new("Highlight", {
                        Adornee = chr,
                        FillColor = color,
                        OutlineColor = color,
                        FillTransparency = 0.65,
                        OutlineTransparency = 0,
                        DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
                    }, espFolder)
                    local bb, lbl = espMakeTag(root, color)
                    espItems[plr] = {
                        kind = "player",
                        chr = chr,
                        killer = killer,
                        part = root,
                        hl = hl,
                        bb = bb,
                        lbl = lbl,
                        text = plr.DisplayName .. (killer and " (KILLER)" or ""),
                    }
                end
            end
        end
    end
    for key, it in pairs(espItems) do
        if it.kind == "player" and not alive[key] then
            espRemove(key)
        end
    end
end

-- generators: models named "Generator" anywhere in workspace (set is kept up to date via DescendantAdded)
local genSet = {}

local function espIsGenerator(obj)
    return obj:IsA("Model") and string.lower(obj.Name) == "generator"
end

for _, obj in ipairs(workspace:GetDescendants()) do
    if espIsGenerator(obj) then genSet[obj] = true end
end

connect(workspace.DescendantAdded, function(obj)
    if espIsGenerator(obj) then genSet[obj] = true end
end)

local function espRefreshGenerators()
    local alive = {}
    if ESP.generators then
        for model in pairs(genSet) do
            if model.Parent then
                local part = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
                if part then
                    alive[model] = true
                    local it = espItems[model]
                    if it and it.part ~= part then
                        espRemove(model)
                        it = nil
                    end
                    if not it then
                        local color = ESPColors.generators
                        local hl = new("Highlight", {
                            Adornee = model,
                            FillColor = color,
                            OutlineColor = color,
                            FillTransparency = 0.65,
                            OutlineTransparency = 0,
                            DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
                        }, espFolder)
                        local bb, lbl = espMakeTag(part, color)
                        espItems[model] = {
                            kind = "object",
                            cat = "generators",
                            part = part,
                            hl = hl,
                            bb = bb,
                            lbl = lbl,
                            text = "Generator",
                        }
                    end
                end
            else
                genSet[model] = nil
            end
        end
    end
    for key, it in pairs(espItems) do
        if it.cat == "generators" and not alive[key] then
            espRemove(key)
        end
    end
end

local function espSet(flag, v)
    ESP[flag] = v
    espRefreshPlayers()
    espRefreshGenerators()
end

local espT1, espT2 = 0, 0
connect(RunService.Heartbeat, function(dt)
    espT1 = espT1 + dt
    espT2 = espT2 + dt

    if espT1 >= 0.1 then
        espT1 = 0
        local cam = workspace.CurrentCamera
        if cam then
            local cp = cam.CFrame.Position
            for _, it in pairs(espItems) do
                local part = it.part
                if part and part.Parent then
                    if ESP.names then
                        it.lbl.Text = string.format("%s [%d]", it.extra and it.extra() or it.text, math.floor((cp - part.Position).Magnitude))
                    else
                        it.lbl.Text = ""
                    end
                end
            end
        end
    end

    if espT2 >= 0.5 then
        espT2 = 0
        if ESP.survivors or ESP.killer then espRefreshPlayers() end
        if ESP.generators then espRefreshGenerators() end
    end
end)

