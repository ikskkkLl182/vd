-- запись ручных попаданий: жми пробел сам во время скилчека
-- (в идеал) на капкане / гене / лечении. в F9 печатает needle/goal/diff,
-- в капкане ещё и учит источник зоны (SC_LEARN). полный снимок -> vd_rec.txt
connect(UserInputService.InputBegan, function(input)
    if input.KeyCode ~= SC_CFG.key or os.clock() < scAutoUntil then return end
    if not scN or not scN:IsDescendantOf(game) or not scZ or not scZ:IsDescendantOf(game) then
        scFindAll()
    end
    if not scN or not scZ or not scGuiVisible(scN) then return end
    local ctx, rawId = scCtxFromChar()
    ctx = ctx or scCtxProximity()
    local rot = scNorm(scN.Rotation)
    local goal = scNorm(scZ.Rotation)
    local line = string.format("[REC] ctx=%s id=%s needle=%.1f goal=%.1f diff=%.1f",
        tostring(ctx), tostring(rawId), rot, goal, (rot - goal) % 360)
    warn(line)

    local check, c, size = scBase()
    if check then
        local tipA = scTipAngle(c, size)
        local zs = scGeom()
        warn(string.format("[REC] geo zone=%s tip=%s",
            zs and string.format("%.1f", zs) or "nil",
            tipA and string.format("%.1f", tipA) or "nil"))
        if appendfile then
            pcall(appendfile, "vd_rec.txt", line .. "\n  tip=" .. tostring(tipA) .. " " .. scSnapString(scSnapshot(check, c, size)) .. "\n")
        end
        if ctx == "trap" then
            scLearnAdd(rot)
        end
    elseif appendfile then
        pcall(appendfile, "vd_rec.txt", line .. "\n")
    end
end)

