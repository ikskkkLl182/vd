local espFolder = new("Folder", {Name = "ESP"}, gui)

local ESP = {
    survivors = false,
    killer = false,
    generators = false,
    names = true,
}

local espItems = {}

local function espRemove(key)
    local it = espItems[key]
    if not it then return end
    espItems[key] = nil
    pcall(function() if it.hl then it.hl:Destroy() end end)
    pcall(function() it.bb:Destroy() end)
end

local function espClear(filter)
    for key, it in pairs(espItems) do
        if not filter or filter(it) then
            espRemove(key)
        end
    end
end

local function espMakeTag(part, color)
    local bb = new("BillboardGui", {
        Adornee = part,
        AlwaysOnTop = true,
        Size = UDim2.fromOffset(150, 22),
        StudsOffset = Vector3.new(0, 3, 0),
        LightInfluence = 0,
        ResetOnSpawn = false,
    }, espFolder)
    local lbl = new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextColor3 = color,
        TextStrokeTransparency = 0.3,
        Text = "",
    }, bb)
    return bb, lbl
end

local function espApplyColors()
    for _, it in pairs(espItems) do
        local c
        if it.kind == "player" then
            c = it.killer and ESPColors.killer or ESPColors.survivors
        else
            c = ESPColors[it.cat]
        end
        if c then
            if it.hl then
                it.hl.FillColor = c
                it.hl.OutlineColor = c
            end
            it.lbl.TextColor3 = c
        end
    end
end

local function espIsKiller(plr)
    local team = plr.Team
    if team and string.find(string.lower(team.Name), "kill", 1, true) then return true end

    local function check(inst)
        for _, name in ipairs({"Killer", "IsKiller", "killer", "Role", "role", "Team", "team"}) do
            local v = inst:GetAttribute(name)
            if v == true and string.find(string.lower(name), "kill", 1, true) then return true end
            if type(v) == "string" and string.find(string.lower(v), "kill", 1, true) then return true end
        end
        return false
    end

    if check(plr) then return true end
    local chr = plr.Character
    if chr then
        if check(chr) then return true end
        if chr:FindFirstChild("Killer") then return true end
    end
    return false
end

local function espRefreshPlayers()
    local alive = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and not string.find(plr.Team and string.lower(plr.Team.Name) or "", "spect", 1, true) then
            local killer = espIsKiller(plr)
            local want = (killer and ESP.killer) or ((not killer) and ESP.survivors)
            local chr = plr.Character
            local root = chr and chr:FindFirstChild("HumanoidRootPart")
            local hum = chr and chr:FindFirstChildOfClass("Humanoid")
            if want and chr and root and (not hum or hum.Health > 0) then
                alive[plr] = true
                local color = killer and ESPColors.killer or ESPColors.survivors
                local it = espItems[plr]
                if it and (it.chr ~= chr or it.killer ~= killer) then
                    espRemove(plr)
                    it = nil
                end
                if not it then
                    local hl = new("Highlight", {
                        Adornee = chr,
                        FillColor = color,
                        OutlineColor = color,
                        FillTransparency = 0.65,
                        OutlineTransparency = 0,
                        DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
                    }, espFolder)
                    local bb, lbl = espMakeTag(root, color)
                    espItems[plr] = {
                        kind = "player",
                        chr = chr,
                        killer = killer,
                        part = root,
                        hl = hl,
                        bb = bb,
                        lbl = lbl,
                        text = plr.DisplayName .. (killer and " (KILLER)" or ""),
                    }
                end
            end
        end
    end
    for key, it in pairs(espItems) do
        if it.kind == "player" and not alive[key] then
            espRemove(key)
        end
    end
end

local genSet = {}

local function espIsGenerator(obj)
    return obj:IsA("Model") and string.lower(obj.Name) == "generator"
end

for _, obj in ipairs(workspace:GetDescendants()) do
    if espIsGenerator(obj) then genSet[obj] = true end
end

connect(workspace.DescendantAdded, function(obj)
    if espIsGenerator(obj) then genSet[obj] = true end
end)

local function espReadValue(obj, name)
    if not obj then return nil end
    local ok, value = pcall(function() return obj:GetAttribute(name) end)
    if ok and value ~= nil then return value end
    local child = obj:FindFirstChild(name)
    if child then
        local good, result = pcall(function() return child.Value end)
        if good then return result end
    end
    return nil
end

local function espGeneratorComplete(model)
    if not model or not model.Parent then return true end

    for _, name in ipairs({"Completed", "IsCompleted", "Repaired", "IsRepaired", "Fixed", "IsFixed"}) do
        local value = espReadValue(model, name)
        if value == true then return true end
    end

    for _, name in ipairs({"RepairProgress", "Progress"}) do
        local value = espReadValue(model, name)
        if type(value) == "number" then
            if value >= 100 or (value > 0 and value <= 1 and value >= 0.999) then
                return true
            end
        end
    end

    local state = espReadValue(model, "State") or espReadValue(model, "Status")
    if type(state) == "string" then
        state = string.lower(state)
        if state == "complete" or state == "completed" or state == "repaired" or state == "fixed" then
            return true
        end
    end
    return false
end

local function espRefreshGenerators()
    local alive = {}
    if ESP.generators then
        for model in pairs(genSet) do
            if not model.Parent then
                genSet[model] = nil
                espRemove(model)
            elseif espGeneratorComplete(model) then
                genSet[model] = nil
                espRemove(model)
            else
                local part = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
                if part then
                    alive[model] = true
                    local it = espItems[model]
                    if it and it.part ~= part then
                        espRemove(model)
                        it = nil
                    end
                    if not it then
                        local color = ESPColors.generators
                        local hl = new("Highlight", {
                            Adornee = model,
                            FillColor = color,
                            OutlineColor = color,
                            FillTransparency = 0.65,
                            OutlineTransparency = 0,
                            DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
                        }, espFolder)
                        local bb, lbl = espMakeTag(part, color)
                        espItems[model] = {
                            kind = "object",
                            cat = "generators",
                            part = part,
                            hl = hl,
                            bb = bb,
                            lbl = lbl,
                            text = "Generator",
                        }
                    end
                end
            end
        end
    end
    for key, it in pairs(espItems) do
        if it.cat == "generators" and not alive[key] then
            espRemove(key)
        end
    end
end

local function espSet(flag, v)
    ESP[flag] = v
    espRefreshPlayers()
    espRefreshGenerators()
end

local espT1, espT2 = 0, 0
connect(RunService.Heartbeat, function(dt)
    espT1 = espT1 + dt
    espT2 = espT2 + dt

    if espT1 >= 0.1 then
        espT1 = 0
        local cam = workspace.CurrentCamera
        if cam then
            local cp = cam.CFrame.Position
            for _, it in pairs(espItems) do
                local part = it.part
                if part and part.Parent then
                    if ESP.names then
                        it.lbl.Text = string.format("%s [%d]", it.extra and it.extra() or it.text, math.floor((cp - part.Position).Magnitude))
                    else
                        it.lbl.Text = ""
                    end
                end
            end
        end
    end

    if espT2 >= 0.5 then
        espT2 = 0
        if ESP.survivors or ESP.killer then espRefreshPlayers() end
        if ESP.generators then espRefreshGenerators() end
    end
end)

---------------------------------------------------------------------
-- Auto skill checks: detects each visible check independently.
-- King checks are treated as consecutive ordinary checks; no server remotes.
---------------------------------------------------------------------
local VirtualInputManager = nil
pcall(function()
    VirtualInputManager = game:GetService("VirtualInputManager")
end)

local SC = {
    enabled = false,
    perfect = true,
}

local SC_CFG = {
    guiName = "SkillCheckPromptGui",
    guiWords = {"skillcheck", "skill", "check"},
    needleWords = {"line", "needle", "pointer", "hand", "arrow", "marker"},
    zoneWords = {"goal", "zone", "success", "target"},
    key = Enum.KeyCode.Space,
    mobileLead = 0.025,
    actionPath = "Survivor-mob.Controls.action.check",
    touchId = 8822,
}

local SC_TIMING = {
    perfectCenter = 111,
    perfectTol = 4,
    normalCenter = 127,
    normalTol = 4,
    lead = 0.012,
    extra = 0,
}

local function scIsMobile()
    return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

local function scMatch(name, words)
    name = string.lower(tostring(name or ""))
    for _, word in ipairs(words) do
        if string.find(name, word, 1, true) then return true end
    end
    return false
end

local function scGuiVisible(obj)
    local p = obj
    while p do
        if p:IsA("GuiObject") and not p.Visible then return false end
        if p:IsA("ScreenGui") and not p.Enabled then return false end
        p = p.Parent
    end
    return true
end

local function scNorm(a)
    return a % 360
end

local function scDiff(a, b)
    return ((a - b + 180) % 360) - 180
end

local function scGetActionButton()
    local pg = player:FindFirstChildOfClass("PlayerGui") or player:FindFirstChild("PlayerGui")
    if not pg then return nil end

    local current = pg
    for segment in string.gmatch(SC_CFG.actionPath, "[^%.]+") do
        current = current and current:FindFirstChild(segment)
    end
    if current and current:IsA("GuiObject") and scGuiVisible(current) then
        return current
    end

    -- UI paths can differ between device layouts/game updates; search visible action buttons.
    local best, bestScore = nil, -math.huge
    for _, item in ipairs(pg:GetDescendants()) do
        if (item:IsA("TextButton") or item:IsA("ImageButton")) and scGuiVisible(item) then
            local n = string.lower(item.Name)
            local score = 0
            if n == "check" then score = score + 8 end
            if string.find(n, "action", 1, true) then score = score + 5 end
            if string.find(n, "check", 1, true) then score = score + 4 end
            if string.find(n, "skill", 1, true) then score = score + 3 end
            if item.AbsoluteSize.X > 0 and item.AbsoluteSize.Y > 0 then
                score = score + 1
            end
            if score > bestScore then best, bestScore = item, score end
        end
    end
    return bestScore >= 4 and best or nil
end

local scN, scZ, scB = nil, nil, nil
local scLast, scLastGoal = nil, nil
local scLastAt = 0
local scFired = false
local scPressTime = 0
local scRefreshAt = 0
local scVelocity = 0

local function scReset()
    scN, scZ, scB = nil, nil, nil
    scLast, scLastGoal = nil, nil
    scLastAt = 0
    scFired = false
    scPressTime = 0
    scRefreshAt = 0
    scVelocity = 0
end

local function scFindAll()
    scN, scZ, scB = nil, nil, nil
    local pg = player:FindFirstChildOfClass("PlayerGui") or player:FindFirstChild("PlayerGui")
    if not pg then return false end

    local function inspect(screen)
        local check = screen:FindFirstChild("Check", true)
        local needle = check and check:FindFirstChild("Line", true)
        local zone = check and check:FindFirstChild("Goal", true)

        if not (needle and zone) then
            for _, d in ipairs(screen:GetDescendants()) do
                if d:IsA("GuiObject") then
                    if not needle and scMatch(d.Name, SC_CFG.needleWords) then needle = d end
                    if not zone and scMatch(d.Name, SC_CFG.zoneWords) then zone = d end
                end
            end
        end

        if needle and zone and needle:IsA("GuiObject") and zone:IsA("GuiObject") then
            scN, scZ = needle, zone
            scB = scGetActionButton()
            return true
        end
        return false
    end

    local mainPrompt = pg:FindFirstChild(SC_CFG.guiName)
    if mainPrompt and inspect(mainPrompt) then return true end

    for _, child in ipairs(pg:GetChildren()) do
        if child:IsA("ScreenGui") and scMatch(child.Name, SC_CFG.guiWords) then
            if inspect(child) then return true end
        end
    end
    return false
end

local function scIsTrapCheck()
    local chr = player.Character
    if not chr then return false end
    for _, child in ipairs(chr:GetChildren()) do
        local n = string.lower(child.Name)
        if string.find(n, "skillcheck", 1, true) and string.find(n, "trap", 1, true) then
            return true
        end
    end
    return false
end

local function scPressKey()
    if not VirtualInputManager then return false end
    local ok = pcall(function()
        VirtualInputManager:SendKeyEvent(true, SC_CFG.key, false, game)
        task.wait(0.025)
        VirtualInputManager:SendKeyEvent(false, SC_CFG.key, false, game)
    end)
    return ok
end

local function scTapButton()
    scB = (scB and scB.Parent and scGuiVisible(scB)) and scB or scGetActionButton()
    if not scB or not VirtualInputManager then return false end

    local p, size = scB.AbsolutePosition, scB.AbsoluteSize
    if size.X <= 0 or size.Y <= 0 then return false end

    local inset = Vector2.zero
    local screenGui = scB:FindFirstAncestorOfClass("ScreenGui")
    if screenGui and not screenGui.IgnoreGuiInset then
        local topLeft = GuiService:GetGuiInset()
        inset = Vector2.new(topLeft.X, topLeft.Y)
    end
    local x = p.X + size.X / 2 + inset.X
    local y = p.Y + size.Y / 2 + inset.Y

    return pcall(function()
        VirtualInputManager:SendTouchEvent(SC_CFG.touchId, 0, x, y)
        task.wait(0.015)
        VirtualInputManager:SendTouchEvent(SC_CFG.touchId, 2, x, y)
    end)
end

local function scPress()
    task.spawn(function()
        if scIsMobile() then
            if scTapButton() then return end
        end
        scPressKey()
    end)
end

connect(player.CharacterAdded, scReset)
do
    local pg = player:FindFirstChildOfClass("PlayerGui") or player:FindFirstChild("PlayerGui")
    if pg then connect(pg.ChildAdded, scReset) end
end

local function scStep(dt)
    if not SC.enabled then
        scReset()
        return
    end

    local now = os.clock()
    local stale = not scN or not scZ
        or not scN:IsDescendantOf(game)
        or not scZ:IsDescendantOf(game)

    if stale or now >= scRefreshAt then
        scRefreshAt = now + 0.15
        scFindAll()
    end

    if not scN or not scZ or not scGuiVisible(scN) or not scGuiVisible(scZ) then
        scReset()
        return
    end

    if scIsTrapCheck() then
        scLast = scNorm(scN.Rotation)
        scLastGoal = scNorm(scZ.Rotation)
        scLastAt = now
        return
    end

    local rot = scNorm(scN.Rotation)
    local goal = scNorm(scZ.Rotation)

    if scLast == nil or scLastAt == 0 then
        scLast, scLastGoal, scLastAt = rot, goal, now
        scFired = false
        return
    end

    local elapsed = math.max(now - scLastAt, dt, 1 / 240)
    local delta = scDiff(rot, scLast)
    local velocity = delta / elapsed
    local previousVelocity = scVelocity
    -- Ignore tiny UI animation jitter, but adapt automatically to faster consecutive checks.
    if math.abs(velocity) >= 12 then
        scVelocity = velocity
    end

    -- A new check in a King sequence may keep the prompt open but reset the needle
    -- or move the target. Re-arm as soon as that transition is observed.
    local goalChanged = math.abs(scDiff(goal, scLastGoal or goal)) >= 1.5
    local needleReset = math.abs(delta) > 35 and previousVelocity ~= 0 and delta * previousVelocity < 0
    local targetCenter = SC.perfect and SC_TIMING.perfectCenter or SC_TIMING.normalCenter
    local target = scNorm(goal + targetCenter + SC_TIMING.extra)
    local distanceFromTarget = math.abs(scDiff(rot, target))

    if scFired then
        if goalChanged or needleReset or (now - scPressTime >= 0.11 and distanceFromTarget >= 38) then
            scFired = false
        else
            scLast, scLastGoal, scLastAt = rot, goal, now
            return
        end
    end

    if math.abs(velocity) < 12 then
        scLast, scLastGoal, scLastAt = rot, goal, now
        return
    end

    local lead = SC_TIMING.lead + (scIsMobile() and SC_CFG.mobileLead or 0)
    local predicted = scNorm(rot + velocity * (lead + elapsed))
    local dNow = scDiff(target, rot)
    local dPredicted = scDiff(target, predicted)
    local crossed = (dNow == 0) or (dNow * dPredicted <= 0 and math.abs(dNow) < 55)
    local tolerance = SC.perfect and SC_TIMING.perfectTol or SC_TIMING.normalTol
    local nearAndMovingToward = math.abs(dNow) <= tolerance and (dNow * velocity > 0)

    if crossed or nearAndMovingToward then
        scFired = true
        scPressTime = now
        scPress()
    end

    scLast, scLastGoal, scLastAt = rot, goal, now
end

---------------------------------------------------------------------
-- Local speed-effect control.
-- This changes the local Humanoid WalkSpeed only; it does not create a
-- server-authoritative game status effect or bypass server validation.
---------------------------------------------------------------------
local SPEED = {
    enabled = false,
    multiplier = 1.00,
    humanoid = nil,
    base = nil,
    lastApplied = nil,
    applying = false,
}

local function speedAttach(character)
    SPEED.humanoid = nil
    SPEED.base = nil
    SPEED.lastApplied = nil
    local hum = character and character:FindFirstChildOfClass("Humanoid")
    if not hum and character then
        hum = character:WaitForChild("Humanoid", 5)
    end
    if hum then
        SPEED.humanoid = hum
        SPEED.base = hum.WalkSpeed
    end
end

local function speedApply()
    local hum = SPEED.humanoid
    if not hum or not hum.Parent then return end
    if not SPEED.enabled then
        if SPEED.base then
            SPEED.applying = true
            pcall(function() hum.WalkSpeed = SPEED.base end)
            SPEED.applying = false
        end
        SPEED.lastApplied = nil
        return
    end
    local mult = math.clamp(SPEED.multiplier, 1, 1.30)
    if SPEED.base == nil then SPEED.base = hum.WalkSpeed end
    -- If the game updates its underlying speed, use that as the new base.
    if SPEED.lastApplied and not SPEED.applying
        and math.abs(hum.WalkSpeed - SPEED.lastApplied) > 0.5 then
        SPEED.base = hum.WalkSpeed
    end
    local wanted = SPEED.base * mult
    if math.abs(hum.WalkSpeed - wanted) > 0.05 then
        SPEED.applying = true
        pcall(function() hum.WalkSpeed = wanted end)
        SPEED.applying = false
    end
    SPEED.lastApplied = wanted
end

connect(player.CharacterAdded, function(character)
    task.spawn(function()
        speedAttach(character)
        speedApply()
    end)
end)
if player.Character then task.spawn(speedAttach, player.Character) end

