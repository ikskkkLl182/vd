env.__VDEspCleanup = function()
    saveColors()
    SC.auto = false
    PAL.block = false
    pcall(palletStop)
    ESP.survivors, ESP.killer, ESP.generators, ESP.traps = false, false, false, false
    pcall(espUpdatePlayers)
    pcall(espUpdateGenerators)
    pcall(espUpdateTraps)
    pcall(mouseRestore)

    for _, c in ipairs(connections) do
        pcall(function() c:Disconnect() end)
    end
    gui:Destroy()
    env.__VDEspCleanup = nil
end
