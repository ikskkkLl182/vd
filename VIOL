        Position = UDim2.fromOffset(14, 33),
        Size = UDim2.new(1, -28, 0, 8),
        BackgroundColor3 = THEME.off,
        BorderSizePixel = 0,
        Active = true,
    }, row)
    corner(track, 4)

    local fill = new("Frame", {
        Size = UDim2.fromScale(0, 1),
        BackgroundColor3 = THEME.accent,
        BorderSizePixel = 0,
    }, track)
    corner(fill, 4)

    local knob = new("Frame", {
        Size = UDim2.fromOffset(16, 16),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0, 0.5),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
    }, track)
    corner(knob, 8)

    local value = default

    local function render()
        local a = (value - minV) / (maxV - minV)
        fill.Size = UDim2.fromScale(a, 1)
        knob.Position = UDim2.fromScale(a, 0.5)
        valLbl.Text = string.format(fmt, value)
    end

    local function fromInput(input)
        local w = track.AbsoluteSize.X
        if w <= 0 then return end
        local a = math.clamp((input.Position.X - track.AbsolutePosition.X) / w, 0, 1)
        local v = minV + a * (maxV - minV)
        v = math.floor(v / step + 0.5) * step
        v = math.clamp(v, minV, maxV)
        if v ~= value then
            value = v
            render()
            pcall(onChange, v)
        end
    end

    local drag = false
    connect(track.InputBegan, function(input)
        if isPointer(input) then
            drag = true
            page.ScrollingEnabled = false
            fromInput(input)
        end
    end)
    connect(UserInputService.InputChanged, function(input)
        if drag and isMove(input) then
            fromInput(input)
        end
    end)
    connect(UserInputService.InputEnded, function(input)
        if drag and isPointer(input) then
            drag = false
            page.ScrollingEnabled = true
            if onCommit then pcall(onCommit, value) end
        end
    end)

    render()
end

