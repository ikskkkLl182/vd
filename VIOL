local cam0 = workspace.CurrentCamera
local vp0 = cam0 and cam0.ViewportSize or Vector2.new(800, 600)

local icon = new("TextButton", {
    Name = "ToggleIcon",
    Size = UDim2.fromOffset(50, 50),
    Position = UDim2.fromOffset(16, math.floor(vp0.Y * 0.35)),
    BackgroundColor3 = THEME.bg,
    AutoButtonColor = false,
    Text = "pups",
    Font = Enum.Font.GothamBlack,
    TextSize = 14,
    TextColor3 = Color3.new(1, 1, 1),
    ZIndex = 20,
}, gui)
corner(icon, 25)
local iconStroke = new("UIStroke", {
    Thickness = 2.5,
    Color = Color3.new(1, 1, 1),
    ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
}, icon)
local iconGrad = new("UIGradient", {
    Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, THEME.accent),
        ColorSequenceKeypoint.new(0.5, THEME.accent2),
        ColorSequenceKeypoint.new(1, THEME.accent),
    }),
}, iconStroke)

local iconDown, iconMoved = false, false
local iconStartIn, iconStartPos = nil, nil

connect(icon.InputBegan, function(input)
    if isPointer(input) then
        iconDown = true
        iconMoved = false
        iconStartIn = input.Position
        iconStartPos = icon.Position
    end
end)

connect(UserInputService.InputChanged, function(input)
    if iconDown and isMove(input) then
        local d = input.Position - iconStartIn
        if d.Magnitude > 6 then
            iconMoved = true
        end
        if iconMoved then
            local cam = workspace.CurrentCamera
            local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
            local size = icon.AbsoluteSize
            local x = math.clamp(iconStartPos.X.Offset + d.X, 0, vp.X - size.X)
            local y = math.clamp(iconStartPos.Y.Offset + d.Y, 0, vp.Y - size.Y)
            icon.Position = UDim2.fromOffset(x, y)
        end
    end
end)

connect(UserInputService.InputEnded, function(input)
    if iconDown and isPointer(input) then
        iconDown = false
        if not iconMoved then
            setOpen(not opened)
        end
    end
end)

