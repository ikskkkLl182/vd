    local lbl = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(14, 6),
        Size = UDim2.new(1, -28, 0, 18),
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = THEME.text,
        Text = string.format("%s: %.2f", text, defaultV),
    }, row)

    local track = new("Frame", {
        Position = UDim2.fromOffset(14, 32),
        Size = UDim2.new(1, -28, 0, 8),
        BackgroundColor3 = THEME.off,
        BorderSizePixel = 0,
        Active = true,
    }, row)
    corner(track, 4)

    local fill = new("Frame", {
        Size = UDim2.new((defaultV - minV) / (maxV - minV), 0, 1, 0),
        BackgroundColor3 = THEME.accent,
        BorderSizePixel = 0,
    }, track)
    corner(fill, 4)

    local knob = new("Frame", {
        Size = UDim2.fromOffset(14, 14),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new((defaultV - minV) / (maxV - minV), 0, 0.5, 0),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
    }, track)
    corner(knob, 7)

    local value = defaultV
    local dragging = false

    local function setV(v)
        value = math.clamp(v, minV, maxV)
        local t = (value - minV) / (maxV - minV)
        fill.Size = UDim2.new(t, 0, 1, 0)
        knob.Position = UDim2.new(t, 0, 0.5, 0)
        lbl.Text = string.format("%s: %.2f", text, value)
        pcall(callback, value)
    end

    local function fromInput(input)
        local w = track.AbsoluteSize.X
        if w <= 0 then return end
        local v = minV + math.clamp((input.Position.X - track.AbsolutePosition.X) / w, 0, 1) * (maxV - minV)
        setV(v)
    end

    connect(track.InputBegan, function(input)
        if isPointer(input) then
            dragging = true
            fromInput(input)
        end
    end)
    connect(UserInputService.InputChanged, function(input)
        if dragging and isMove(input) then
            fromInput(input)
        end
    end)
    connect(UserInputService.InputEnded, function(input)
        if isPointer(input) then
            dragging = false
        end
    end)

    return {set = setV, get = function() return value end}
end

